#!/bin/bash
#===============================================================================
# kiosk-webkiosk - the WEB KIOSK display loop, installed as /etc/kiosk/webkiosk.sh.
#
# Run inside the X session (cams.sh execs this when the screen's type is Web
# kiosk) instead of the camera wall. Shows a configured web page full-screen in
# Falkon (QtWebEngine = Chromium's Blink engine; a plain .deb from the Ubuntu
# archive, no snap). The agent installs the browser when a screen becomes a web
# kiosk. Chromium is still used if someone has installed a real one.
#
# Phase 1: a single URL + an optional periodic refresh. Two placeholder pages:
#   - DEFAULT      : shown when the screen has no kiosk / no URL configured
#   - UNREACHABLE  : shown when the URL can't be reached (checked by curl first,
#                    so we never show Chromium's raw error page); the real URL is
#                    re-checked each cycle and shown again once it comes back.
# Rotation through several pages (per-page dwell) is phase 2.
#
# Mode/URL changes: config.json is polled each cycle. A URL/placeholder change
# relaunches the browser at the new target; a refresh is sent with xdotool (no
# relaunch, no flicker). If the screen is no longer a web kiosk, this exits so
# kiosk-display restarts and cams.sh re-branches to the camera wall.
#===============================================================================
set -uo pipefail

CONFIG=${KIOSK_CONFIG:-/etc/kiosk/config.json}
CHECK_INTERVAL=${KIOSK_WEBKIOSK_INTERVAL:-10}   # reachability + config poll cadence (seconds)

# Maintenance (kiosk-maintenance script): while this flag file exists we yield :0 - kill the live
# kiosk browser (releasing the shared 'kiosk' Falkon profile so the hidden login session can use it)
# and show a placeholder from a THROWAWAY profile, so onlookers never see the admin logging in.
MAINT_DIR=${KIOSK_RUN_DIR:-/run/kiosk}
MAINT_FLAG="$MAINT_DIR/maintenance"
MAINT_YIELDED="$MAINT_DIR/maintenance-yielded"

# Chromium's persistent profile - SHARED with the maintenance-login session so a login done there
# carries over to the live screen. The placeholder uses a throwaway copy ("-maint") so it never locks
# the shared one.
KIOSK_CHROMIUM_DIR=${KIOSK_CHROMIUM_DIR:-$HOME/.config/kiosk-chromium}

# Downloaded videos for web-kiosk video pages, cached by media id so a reboot/relaunch doesn't refetch
# a large file. Under the kiosk user's HOME (webkiosk.sh runs as that user; /var/lib isn't writable to it).
MEDIA_CACHE=${KIOSK_MEDIA_CACHE:-$HOME/.cache/kiosk-media}

# mpv JSON-IPC socket for the playing video, so the manager's play/pause/restart commands can drive it.
# In /tmp (world-writable; the kiosk user's mpv creates it, the root agent connects) - same place the
# camera wall puts its per-tile sockets. Must match VIDEO_SOCK in kiosk-agent.
VIDEO_SOCK=${KIOSK_VIDEO_SOCK:-/tmp/kiosk-video.sock}

say() { logger -t kiosk-webkiosk -- "$*" 2>/dev/null; echo "kiosk-webkiosk: $*" >&2; }

# The placeholder pages are served over HTTP by the manager (the URL the agent already syncs with) so
# they are edited centrally and match the manager's look. The local file:// copies are the fallback
# (used only if the manager URL is somehow unset); Falkon is a normal .deb and can read them fine.
_resolve_placeholders() {
  local m=${MANAGER_URL%/}
  if [[ -n $m ]]; then
    PLACEHOLDER_DEFAULT_TARGET="$m/kiosk/placeholder/default"
    PLACEHOLDER_UNREACHABLE_TARGET="$m/kiosk/placeholder/unreachable"
    PLACEHOLDER_MAINTENANCE_TARGET="$m/kiosk/placeholder/maintenance"
  else
    PLACEHOLDER_DEFAULT_TARGET="file://${KIOSK_PLACEHOLDER_DEFAULT:-/etc/kiosk/placeholder-default.html}"
    PLACEHOLDER_UNREACHABLE_TARGET="file://${KIOSK_PLACEHOLDER_UNREACHABLE:-/etc/kiosk/placeholder-unreachable.html}"
    PLACEHOLDER_MAINTENANCE_TARGET="$PLACEHOLDER_DEFAULT_TARGET"
  fi
}
MANAGER_URL=""
# kiosk.conf is the viewer-readable base file (agent.env is 600 root - we run as the kiosk user and
# can't read it, which left MANAGER_URL empty and forced the unreadable file:// placeholder fallback).
source /etc/kiosk/kiosk.conf 2>/dev/null || true   # MANAGER_URL (+ KIOSK_USER/HOME)
_resolve_placeholders

# Preferred browser: Google Chrome (real .deb, modern engine, UNCONFINED - unlike the snap chromium,
# which ignores --user-data-dir and so collapsed the display + maintenance profiles into one, and
# unlike the archive's 2020-era Falkon which modern sites reject). Others are fallbacks only.
browser_bin() {
  local b
  for b in google-chrome-stable google-chrome chromium chromium-browser falkon; do
    command -v "$b" >/dev/null 2>&1 && { echo "$b"; return 0; }
  done
  echo ""
}

# screen_dims -> "W H" from xrandr (same source the camera wall uses), 1920x1080 if it can't be read.
screen_dims() {
  local d
  d=$(xrandr 2>/dev/null | awk '/current/{sub(",", "", $10); print $8, $10; exit}')
  [[ $d =~ ^[0-9]+\ +[0-9]+$ ]] && echo "$d" || echo "1920 1080"
}

# start_wm -> run a tiny window manager so the browser window fills the screen. The boxes run a bare
# X with no WM, so a browser otherwise opens as a small, un-maximised window. matchbox maximises the
# single top-level app window to the whole screen and draws no titlebar/cursor - the standard kiosk
# WM. The camera wall doesn't use it (mpv places its own borderless windows). No-op if absent or
# already running.
start_wm() {
  command -v matchbox-window-manager >/dev/null 2>&1 || { say "matchbox not installed - window may not fill the screen"; return 0; }
  pgrep -x matchbox-window-manager >/dev/null 2>&1 && return 0
  matchbox-window-manager -use_titlebar no -use_cursor no >/dev/null 2>&1 &
  sleep 1
}

# read_cfg -> SCREEN_TYPE, REFRESH, and the ordered page arrays URLS[]/DWELLS[] (+ NPAGES). Pages are
# read by index (not jq's `.[]`), so the tiny test-harness jq shim - which has no array iteration -
# can drive it; real jq on the screen handles either. URL keeps the first page for choose_target.
read_cfg() {
  SCREEN_TYPE=$(jq -r '.screenType // 1' "$CONFIG" 2>/dev/null || echo 1)
  REFRESH=$(jq -r '.webKiosk.refreshSeconds // empty' "$CONFIG" 2>/dev/null || true)
  [[ $REFRESH =~ ^[0-9]+$ ]] || REFRESH=""

  URLS=(); DWELLS=(); KINDS=(); AUTOPLAYS=()
  local i=0 u d k a
  while :; do
    u=$(jq -r ".webKiosk.pages[$i].url // empty" "$CONFIG" 2>/dev/null || true)
    [[ -z $u ]] && break
    URLS+=("$u")
    d=$(jq -r ".webKiosk.pages[$i].dwellSeconds // 30" "$CONFIG" 2>/dev/null || echo 30)
    { [[ $d =~ ^[0-9]+$ ]] && (( d >= 5 )); } || d=30
    DWELLS+=("$d")
    # kind: 1 = web page (browser), 2 = video (mpv). Default 1 for payloads from an older manager.
    k=$(jq -r ".webKiosk.pages[$i].kind // 1" "$CONFIG" 2>/dev/null || echo 1)
    [[ $k == 2 ]] || k=1
    KINDS+=("$k")
    # autoplay (video pages): true = play on load, false = start paused until a play command. Default true.
    a=$(jq -r ".webKiosk.pages[$i].autoplay // true" "$CONFIG" 2>/dev/null || echo true)
    [[ $a == false ]] || a=true
    AUTOPLAYS+=("$a")
    i=$((i + 1))
  done
  NPAGES=${#URLS[@]}
  URL=${URLS[0]:-}
}

# A video page's URL is the manager's media route; it may be stored relative (/kiosk/media/{id}), so
# resolve it against the manager base the same way the placeholders are resolved.
_resolve_media() {
  local u=$1
  [[ $u == /* ]] && echo "${MANAGER_URL%/}$u" || echo "$u"
}

# reachable URL -> 0 if the page responds (HEAD, then GET for servers that refuse HEAD)
reachable() {
  local u=$1
  [[ $u == http://* || $u == https://* ]] || return 1
  curl -ksS -o /dev/null -m 8 --head "$u" 2>/dev/null && return 0
  curl -ksS -o /dev/null -m 8 "$u" 2>/dev/null
}

# target_at INDEX -> the URL (or a placeholder) to show for page INDEX, given reachability. No pages
# at all -> the default placeholder; an unreachable page -> the unreachable placeholder (rotation
# still advances past it, and it is re-checked each time it comes round).
target_at() {
  local idx=$1 u
  if (( NPAGES == 0 )); then
    echo "$PLACEHOLDER_DEFAULT_TARGET"
    return
  fi
  u=${URLS[$idx]}
  # A video page's URL is the manager media route (maybe relative) - resolve it to an absolute URL so
  # the reachability check and the player get the real address.
  [[ ${KINDS[$idx]:-1} == 2 ]] && u=$(_resolve_media "$u")
  if reachable "$u"; then
    echo "$u"
  else
    echo "$PLACEHOLDER_UNREACHABLE_TARGET"
  fi
}

# target_is_video TARGET IDX -> 0 when page IDX is a video AND its target is the real media URL (not a
# placeholder shown because the media was unreachable - those are ordinary web pages).
target_is_video() {
  local t=$1 idx=$2
  [[ ${KINDS[$idx]:-1} == 2 ]] || return 1
  case $t in
    "$PLACEHOLDER_DEFAULT_TARGET"|"$PLACEHOLDER_UNREACHABLE_TARGET"|"$PLACEHOLDER_MAINTENANCE_TARGET") return 1 ;;
  esac
  return 0
}

# choose_target -> target for the first/only page (single-URL path; used by the supervise loop when a
# kiosk has one page, and by the test harness).
choose_target() { target_at 0; }

launch_browser() {   # launch_browser TARGET -> sets BROWSER_PID, BROWSER_KIND (and BROWSER_WID for Falkon)
  local target=$1 bin

  # A video page plays with mpv, not a browser (BROWSER_PID still tracks it so the supervise loop's
  # crash/maintenance handling is unchanged). Checked first so it works even if no browser is installed.
  if target_is_video "$target" "${cur:-0}"; then
    if [[ -n ${KIOSK_DRYRUN:-} ]]; then
      echo "video: $target"; BROWSER_PID=0; BROWSER_KIND=mpv; BROWSER_WID=""; return 0
    fi
    _launch_video "$target"
    return $?
  fi

  bin=$(browser_bin)
  if [[ -z $bin ]]; then say "no browser installed (falkon/chromium) - cannot show web kiosk"; return 1; fi
  BROWSER_KIND=$bin

  if [[ -n ${KIOSK_DRYRUN:-} ]]; then
    echo "browser: $bin $target"
    BROWSER_PID=0
    BROWSER_WID=""
    return 0
  fi

  case $bin in
    falkon) _launch_falkon "$target" ;;
    *)      _launch_chromium "$bin" "$target" ;;
  esac
}

# navigate TARGET -> point the ALREADY-RUNNING browser at a new URL, no relaunch (so rotation and
# reachability changes don't flash). Falkon's single-instance remote does this via --current-tab;
# a plain Chromium has no simple remote, so there we relaunch.
navigate() {
  local target=$1
  if [[ -n ${KIOSK_DRYRUN:-} ]]; then
    echo "navigate: $target"
    return 0
  fi
  # Can't navigate in place to/from a video (mpv has no "open this URL in the running window", and the
  # player type changes): kill the current player and relaunch via launch_browser, which picks mpv/browser.
  if target_is_video "$target" "${cur:-0}" || [[ ${BROWSER_KIND:-} == mpv ]]; then
    kill "$BROWSER_PID" 2>/dev/null || true
    wait "$BROWSER_PID" 2>/dev/null || true
    launch_browser "$target"
    return
  fi
  if [[ ${BROWSER_KIND:-} == falkon ]]; then
    falkon --profile kiosk --current-tab "$target" >/dev/null 2>&1 &
  else
    kill "$BROWSER_PID" 2>/dev/null || true
    wait "$BROWSER_PID" 2>/dev/null || true
    _launch_chromium "${BROWSER_KIND:-chromium}" "$target"
  fi
}

# _fetch_media URL -> prints the local cached path, downloading once (cached by media id so a relaunch
# or reboot doesn't refetch). Returns non-zero if the download fails.
_fetch_media() {
  local url=$1 id local tmp
  id=$(basename "${url%%\?*}")
  [[ $id == *.mp4 ]] || id="$id.mp4"
  local="$MEDIA_CACHE/$id"
  if [[ -s $local ]]; then echo "$local"; return 0; fi
  mkdir -p "$MEDIA_CACHE" 2>/dev/null || true
  tmp="$local.part"
  if curl -fsSL -m 600 -o "$tmp" "$url" 2>/dev/null && [[ -s $tmp ]]; then
    mv -f "$tmp" "$local"; echo "$local"; return 0
  fi
  rm -f "$tmp" 2>/dev/null || true
  return 1
}

# _detect_hdmi_audio -> print the ALSA HDMI output that has a TV connected, or nothing. These boxes run
# bare ALSA (no PulseAudio), so mpv's default sink is the ANALOG card and HDMI gets no sound. Each HDMI
# port is its own ALSA device; mpv labels the one with a connected display by the monitor's name (e.g.
# "SAMSUNG/HDMI Audio Output") and the empty ports generically ("HDMI 1/HDMI Audio Output"). So pick the
# hdmi device whose description is NOT that generic "HDMI <n>/HDMI Audio Output" form. Device ids differ
# per box (CARD=PCH vs CARD=HDMI), which is why we detect rather than hardcode. Nothing connected -> no
# output (mpv falls back to default; a screen with no HDMI audio sink, e.g. a plain monitor, stays silent).
_detect_hdmi_audio() {
  command -v mpv >/dev/null 2>&1 || return 1
  local line dev desc
  while IFS= read -r line; do
    [[ $line == *"alsa/hdmi:CARD="* ]] || continue
    dev=${line#*\'}; dev=${dev%%\'*}
    desc=${line#*\(}; desc=${desc%\)*}
    [[ $desc == *"HDMI "[0-9]"/HDMI Audio Output"* ]] && continue   # generic/empty port
    echo "$dev"; return 0
  done < <(mpv --audio-device=help 2>/dev/null)
  return 1
}

# _launch_video RESOLVED_URL -> download + play the MP4 full-screen WITH sound, looping. Sets BROWSER_*.
# Mirrors the camera wall's mpv (borderless window placed by --geometry on the bare, WM-less X), but with
# audio on and the file looped. Audio device: KIOSK_AUDIO_DEVICE override, else the auto-detected HDMI
# sink (the connected TV), else mpv's default.
_launch_video() {
  local url=$1 dims w h local adev paused=
  if ! command -v mpv >/dev/null 2>&1; then say "mpv not installed - cannot play video page"; return 1; fi
  local=$(_fetch_media "$url") || { say "video download failed ($url)"; return 1; }
  dims=$(screen_dims); w=${dims%% *}; h=${dims##* }
  adev=${KIOSK_AUDIO_DEVICE:-}
  [[ -z $adev ]] && adev=$(_detect_hdmi_audio) || true
  # Autoplay off for this page -> start paused (a still first frame) until a play command arrives.
  [[ ${AUTOPLAYS[${cur:-0}]:-true} == false ]] && paused=yes
  rm -f "$VIDEO_SOCK" 2>/dev/null || true
  mpv --no-osc --no-input-default-bindings --no-input-terminal --no-border --force-window=immediate \
      --geometry="${w}x${h}+0+0" --autofit="${w}x${h}" --ontop \
      --loop-file=inf --keep-open=yes --hwdec=auto --cache=yes --volume=100 \
      --input-ipc-server="$VIDEO_SOCK" ${paused:+--pause=yes} \
      ${adev:+--audio-device="$adev"} \
      "$local" >/dev/null 2>&1 &
  BROWSER_PID=$!
  BROWSER_KIND=mpv
  BROWSER_WID=""
  say "playing video $url (mpv pid $BROWSER_PID${adev:+, audio $adev}${paused:+, paused: autoplay off})"
}

_launch_falkon() {   # Falkon in a dedicated profile, forced full-screen with xdotool
  local target=$1 dims w h wid
  # Dedicated profile -> no first-run wizard, no session-restore prompt. NO --no-remote: rotation
  # navigates this instance with `falkon --current-tab <url>`, which only works when the first launch
  # left the remote socket open. URL passed positionally (works on every Falkon version).
  falkon --profile kiosk "$target" >/dev/null 2>&1 &
  BROWSER_PID=$!
  say "showing $target (falkon pid $BROWSER_PID)"

  # Bare X, no window manager: Falkon won't auto-fill the screen or honour a WM fullscreen request, so
  # drive it directly the way the camera wall drives mpv - size the window to the whole screen, move
  # it to 0,0, focus it, then F11 (Falkon's fullscreen hides its own toolbar + tab bar). windowfocus
  # + an XTEST key (no --window) is used because QtWebEngine ignores synthetic per-window key events.
  dims=$(screen_dims); w=${dims%% *}; h=${dims##* }
  BROWSER_WID=""
  local i
  for i in $(seq 1 30); do
    wid=$(xdotool search --onlyvisible --class '[Ff]alkon' 2>/dev/null | tail -1)
    [[ -n $wid ]] && break
    sleep 0.5
  done
  if [[ -n ${wid:-} ]]; then
    xdotool windowsize "$wid" "$w" "$h" 2>/dev/null || true
    xdotool windowmove "$wid" 0 0 2>/dev/null || true
    xdotool windowfocus "$wid" 2>/dev/null || true
    sleep 0.3
    xdotool key --clearmodifiers F11 2>/dev/null || true
    BROWSER_WID=$wid
  else
    say "falkon window not found via xdotool - page will show but may keep its toolbar"
  fi
}

# A killed Chromium leaves single-instance locks and a "didn't exit cleanly" flag, which make the next
# launch come up BLANK / with a restore prompt. Drop the locks and mark the last session clean before
# every launch on a shared profile - this is what fixes the blank screen after a maintenance cycle.
chromium_prep() {
  local dir=$1
  rm -f "$dir"/Singleton* 2>/dev/null || true
  local prefs="$dir/Default/Preferences"
  [[ -f $prefs ]] && sed -i 's/"exited_cleanly":false/"exited_cleanly":true/g; s/"exit_type":"[^"]*"/"exit_type":"Normal"/g' "$prefs" 2>/dev/null || true
}

# _fit_chromium_window -> size the real Chromium page window to the whole screen and move it to 0,0.
# WHY this is needed: --kiosk only asks the window manager for full-screen, and these boxes run a bare X
# whose only WM (matchbox) is often not even installed/running - so without this the window comes up at a
# default ~half size (the "half a screen" bug on wk-204). So we drive it directly, exactly like the camera
# wall drives mpv and _launch_falkon drives Falkon. Chromium spawns several top-level X windows (a stray
# "google-chrome-stable" window, a clipboard window); only the real page window has WM_CLASS *exactly*
# "Google-chrome", so match it anchored (^...$) to skip the strays. Harmless no-op if xdotool is missing.
_fit_chromium_window() {
  command -v xdotool >/dev/null 2>&1 || return 0
  local dims w h wid i
  dims=$(screen_dims); w=${dims%% *}; h=${dims##* }
  [[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]] || return 0
  for i in $(seq 1 30); do
    wid=$(xdotool search --onlyvisible --class '^Google-chrome$' 2>/dev/null | tail -1)
    [[ -n $wid ]] && break
    sleep 0.5
  done
  [[ -z ${wid:-} ]] && { say "chromium window not found via xdotool - page may not fill the screen"; return 0; }
  xdotool windowsize "$wid" "$w" "$h" 2>/dev/null || true
  xdotool windowmove "$wid" 0 0 2>/dev/null || true
  BROWSER_WID=$wid
}

_launch_chromium() {   # _launch_chromium BIN TARGET
  local bin=$1 target=$2
  # NOT --incognito: the kiosk keeps a persistent profile so logins (done in a maintenance session on
  # the same --user-data-dir) stick. --disable-gpu + friends: these NUCs run a bare X on old Intel
  # graphics where the GPU process often crashes to a black window; software rendering is plenty and
  # far more reliable. --disable-dev-shm-usage avoids crashes on the small default /dev/shm.
  chromium_prep "$KIOSK_CHROMIUM_DIR"
  "$bin" --kiosk --noerrdialogs --disable-infobars --disable-session-crashed-bubble \
    --disable-features=TranslateUI --no-first-run --no-default-browser-check --disable-pinch \
    --overscroll-history-navigation=0 --check-for-update-interval=31536000 --password-store=basic \
    --user-data-dir="$KIOSK_CHROMIUM_DIR" --disable-gpu --disable-dev-shm-usage --app="$target" >/dev/null 2>&1 &
  BROWSER_PID=$!
  BROWSER_WID=""
  say "showing $target (chromium pid $BROWSER_PID)"
  _fit_chromium_window   # --kiosk alone doesn't fill the screen on these WM-less boxes; force it
}

refresh_page() {   # send a reload (F5) to the kiosk window
  [[ -n ${KIOSK_DRYRUN:-} ]] && { echo "refresh"; return; }
  [[ ${BROWSER_KIND:-} == mpv ]] && return 0   # a looping video has nothing to refresh
  command -v xdotool >/dev/null 2>&1 || return 0
  [[ -n ${BROWSER_WID:-} ]] && xdotool windowfocus "$BROWSER_WID" 2>/dev/null || true
  xdotool key --clearmodifiers F5 2>/dev/null || true
}

# launch_placeholder_browser -> show a placeholder on :0 during maintenance, in a THROWAWAY profile
# ('maintenance') so it can't clash with the shared 'kiosk' profile the hidden login session holds.
# Sets PLACEHOLDER_PID. (Phase 1 reuses the default placeholder; a branded maintenance placeholder is
# a phase-2 manager endpoint.)
launch_placeholder_browser() {
  local bin; bin=$(browser_bin)
  if [[ -z $bin ]]; then PLACEHOLDER_PID=""; return 0; fi
  if [[ $bin == falkon ]]; then
    falkon --profile maintenance "$PLACEHOLDER_MAINTENANCE_TARGET" >/dev/null 2>&1 &
  else
    # Chromium on a THROWAWAY profile ("-maint") so it never locks the shared profile the hidden
    # maintenance-login session is using. Wipe it first so it's always clean.
    rm -rf "${KIOSK_CHROMIUM_DIR}-maint" 2>/dev/null || true
    "$bin" --kiosk --noerrdialogs --no-first-run --no-default-browser-check --disable-gpu \
      --disable-dev-shm-usage --user-data-dir="${KIOSK_CHROMIUM_DIR}-maint" \
      --app="$PLACEHOLDER_MAINTENANCE_TARGET" >/dev/null 2>&1 &
  fi
  PLACEHOLDER_PID=$!
  say "maintenance: showing placeholder on the physical screen (pid $PLACEHOLDER_PID)"
  [[ $bin != falkon ]] && _fit_chromium_window   # same WM-less full-screen fix as the live kiosk
}

# Sourced by the test harness, which stubs the helpers and drives them directly.
[[ -n ${KIOSK_WEBKIOSK_TEST:-} ]] && return 0

say "web kiosk display loop starting (config $CONFIG)"
start_wm   # maximise the browser window on the bare, WM-less X

# Keep the monitor awake. cams.sh sets these for the camera wall, but it execs us BEFORE doing so, so
# a web-kiosk screen must do it itself - otherwise the display DPMS-blanks to "no signal" during a
# long maintenance session (or any idle period) and never comes back.
xset s off 2>/dev/null || true
xset -dpms 2>/dev/null || true
xset s noblank 2>/dev/null || true

TICK=${KIOSK_WEBKIOSK_TICK:-5}   # supervise cadence; also the dwell/refresh granularity

read_cfg
cur=0
cfg_sig=$(md5sum "$CONFIG" 2>/dev/null | awk '{print $1}')

# Initial launch. Retry (showing nothing) until a browser is present - the agent installs Falkon when
# a screen becomes a web kiosk, so this covers the gap before that finishes.
target=$(target_at "$cur")
until launch_browser "$target"; do
  sleep "$CHECK_INTERVAL"
  read_cfg
  [[ $SCREEN_TYPE != 2 ]] && { say "no longer web kiosk - exiting"; exit 0; }
  target=$(target_at "$cur")
done
shown=$target
now=$(date +%s); page_since=$now; last_refresh=$now

while true; do
  sleep "$TICK"
  [[ -n ${KIOSK_DRYRUN:-} ]] && break

  # Maintenance gate: yield :0 while an admin logs in over the hidden VNC session. Kill the live
  # kiosk browser (releasing the shared profile), show a placeholder from a throwaway profile, idle
  # until the flag clears, then resume the kiosk (which reloads authenticated from the shared profile).
  if [[ -e $MAINT_FLAG ]]; then
    say "maintenance active - yielding the display"
    kill "$BROWSER_PID" 2>/dev/null || true; wait "$BROWSER_PID" 2>/dev/null || true
    launch_placeholder_browser
    mkdir -p "$MAINT_DIR" 2>/dev/null || true; : > "$MAINT_YIELDED" 2>/dev/null || true
    while [[ -e $MAINT_FLAG ]]; do sleep "$TICK"; done
    say "maintenance cleared - resuming kiosk"
    xset -dpms 2>/dev/null || true; xset s off 2>/dev/null || true; xset dpms force on 2>/dev/null || true
    [[ -n ${PLACEHOLDER_PID:-} ]] && { kill "$PLACEHOLDER_PID" 2>/dev/null || true; wait "$PLACEHOLDER_PID" 2>/dev/null || true; }
    rm -f "$MAINT_YIELDED" 2>/dev/null || true
    read_cfg; cur=0
    target=$(target_at "$cur")
    until launch_browser "$target"; do
      sleep "$CHECK_INTERVAL"
      [[ -e $MAINT_FLAG ]] && break
      read_cfg; [[ $SCREEN_TYPE != 2 ]] && { say "no longer web kiosk - exiting"; exit 0; }
      target=$(target_at "$cur")
    done
    shown=$target; now=$(date +%s); page_since=$now; last_refresh=$now
    cfg_sig=$(md5sum "$CONFIG" 2>/dev/null | awk '{print $1}')
    continue
  fi

  # Browser gone (crash, killed)? Relaunch at the current page.
  if ! kill -0 "$BROWSER_PID" 2>/dev/null; then
    say "browser exited - relaunching"
    target=$(target_at "$cur")
    launch_browser "$target" || { sleep "$CHECK_INTERVAL"; continue; }
    shown=$target; now=$(date +%s); page_since=$now; last_refresh=$now
    continue
  fi

  read_cfg
  if [[ $SCREEN_TYPE != 2 ]]; then
    kill "$BROWSER_PID" 2>/dev/null || true
    say "switched away from web kiosk - exiting"
    exit 0
  fi

  now=$(date +%s)

  # Config changed centrally: restart the rotation from the first page with the new list.
  new_sig=$(md5sum "$CONFIG" 2>/dev/null | awk '{print $1}')
  if [[ $new_sig != "$cfg_sig" ]]; then
    say "config changed - reloading pages"
    cfg_sig=$new_sig
    cur=0
    target=$(target_at "$cur")
    [[ $target != "$shown" ]] && { navigate "$target"; shown=$target; }
    page_since=$now; last_refresh=$now
    continue
  fi

  # Rotation: advance to the next page once the current page's dwell has elapsed (2+ pages only).
  if (( NPAGES >= 2 )); then
    dwell=${DWELLS[$cur]:-30}
    if (( now - page_since >= dwell )); then
      cur=$(( (cur + 1) % NPAGES ))
      target=$(target_at "$cur")
      navigate "$target"; shown=$target
      page_since=$now; last_refresh=$now
      continue
    fi
  fi

  # Reachability of the page currently shown changed (recovered, or just went down): re-point without
  # resetting the dwell clock, so a flapping page doesn't stall the rotation.
  desired=$(target_at "$cur")
  if [[ $desired != "$shown" ]]; then
    say "target changed ($shown -> $desired)"
    navigate "$desired"; shown=$desired; last_refresh=$now
  fi

  # Periodic reload of a real page (data that doesn't refresh itself); mainly the single-page case.
  if [[ -n ${REFRESH:-} && $shown == http* ]] && (( now - last_refresh >= REFRESH )); then
    refresh_page
    last_refresh=$now
  fi
done
