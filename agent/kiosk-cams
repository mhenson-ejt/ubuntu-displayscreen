#!/bin/bash
#===============================================================================
# kiosk-cams - the display loop, installed as /etc/kiosk/cams.sh.
#
# Runs inside the X session started by kiosk-display.service. Reads
# /etc/kiosk/config.json, applies rotation and starts ONE mpv per tile, each a
# borderless window covering its grid cell (empty cells are just the black X
# root). Per-tile players exist so a sick camera only ever disturbs its own
# cell - the previous single-mpv filter graph (hstack/vstack) froze the WHOLE
# wall whenever any one input stalled:
#   - a dropped connection does NOT tear the window down: keep-open holds the
#     last frame and the supervisor reloads the stream in-place over IPC as
#     soon as the NVR answers again, so an outage looks like a paused picture
#     that resumes - never a black cell
#   - a wedged player (clock stuck while data still arrives, or a black
#     window that never starts) is killed + respawned - only that tile; a
#     dead respawn loop is itself respawned. Network starvation is left to
#     ride (mpv resumes by itself) with a long last-resort restart, because
#     killing a buffering player just trades a frozen frame for a black cell
#   - corrupt frames are dropped at the decoder instead of rendered, so a
#     glitch is a blink on one tile, not a white/grey smear that persists
#     until the next keyframe
#   - a latency governor keeps every tile within ~2s of live: backlog left
#     behind by stalls is burned off at 2x speed instead of parking the tile
#     20-40s behind realtime forever
#
# A config change still only needs mpv killed (the agent does `pkill mpv`);
# the supervisor also polls the config file and rebuilds the wall within a few
# seconds of it changing.
#
# Config shape (grid up to 6x6; tiles may come from different NVRs; grid
# positions without a tile stay black; every cell is scaled to fill, so mixed
# camera resolutions are fine):
#   { "gridCols": 3, "gridRows": 2, "subtype": 1,
#     "rotate": "none", "rotateOutput": null,
#     "tiles": [ {"pos": 0, "ip": "..", "port": 554,
#                 "user": "..", "pass": "..", "channel": 1, "subtype": 0}, ... ] }
# Per-tile "subtype" (0 = main stream, 1 = substream) overrides the top-level
# default for that camera; tiles without it use the top-level "subtype".
#
# Set KIOSK_DRYRUN=1 to print the xrandr/mpv commands instead of running them
# (used by tests; no X or mpv needed).
#===============================================================================
CONFIG=${KIOSK_CONFIG:-/etc/kiosk/config.json}
WATCH_INTERVAL=5   # supervisor poll cadence (config changes + tile health)
FREEZE_SECS=30     # hard failures (wedged decoder, black window): restart after this
STARVE_SECS=180    # network starvation (last frame showing, mpv will resume by
                   # itself when data returns): only restart as a last resort -
                   # killing a starved player just turns a frozen frame into a
                   # black cell and a reconnect over the same bad network
RUN_DIR=${KIOSK_RUN_DIR:-/tmp}

# logger, not stderr: startx swallows the X clients' stderr, so journald never saw these
say() { logger -t kiosk-cams -- "$*" 2>/dev/null; echo "kiosk-cams: $*" >&2; }

# TCP probe so an unreachable NVR shows a black cell that keeps retrying,
# instead of mpv burning a connect timeout every couple of seconds
reachable() { # reachable IP PORT
  timeout 3 bash -c "echo > /dev/tcp/$1/$2" 2>/dev/null
}

if [[ -z ${KIOSK_DRYRUN:-} ]]; then
  export LIBVA_DRIVER_NAME=i965
  xset s off
  xset -dpms
  xset s noblank
  xsetroot -solid black 2>/dev/null
fi

urlencode() {
  local s=$1 out="" c hex
  for (( i=0; i<${#s}; i++ )); do
    c=${s:$i:1}
    case $c in [a-zA-Z0-9.~_-]) out+=$c ;; *) printf -v hex '%%%02X' "'$c"; out+=$hex ;; esac
  done
  echo "$out"
}

apply_rotation() { # apply_rotation none|left|right OUTPUT-or-empty
  local rotate=$1 out=$2 mode
  case $rotate in left|right) mode=$rotate ;; *) mode=normal ;; esac
  if [[ -z $out && -z ${KIOSK_DRYRUN:-} ]]; then
    out=$(xrandr | awk '/ connected/{print $1; exit}')
  fi
  if [[ -n ${KIOSK_DRYRUN:-} ]]; then
    echo "XRANDR --output ${out:-auto} --rotate $mode"
  else
    [[ -n $out ]] && xrandr --output "$out" --rotate "$mode" 2>/dev/null
  fi
}

screen_size() { # echoes "W H" for the (already rotated) screen
  if [[ -n ${KIOSK_DRYRUN:-} ]]; then echo "1920 1080"; return; fi
  local dims
  dims=$(xrandr 2>/dev/null | awk '/current/{sub(",", "", $10); print $8, $10; exit}')
  [[ $dims =~ ^[0-9]+\ [0-9]+$ ]] && echo "$dims" || echo "1920 1080"
}

# Asks one tile's mpv for a set of properties over the JSON IPC socket in one
# connection. Prints them space-separated in argument order; "-" for anything
# unavailable (player connecting, property unsupported); booleans as 0/1.
mpv_props() { # mpv_props SOCKET PROP...
  python3 - "$@" <<'PY' 2>/dev/null
import json, socket, sys
sock, props = sys.argv[1], sys.argv[2:]
out = ["-"] * len(props)
try:
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(2)
    s.connect(sock)
    for i, p in enumerate(props):
        s.sendall(json.dumps({"command": ["get_property", p], "request_id": i}).encode() + b"\n")
    buf, seen = b"", 0
    while seen < len(props):
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            if not line.strip():
                continue
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            rid = obj.get("request_id")
            if isinstance(rid, int) and 0 <= rid < len(props):
                seen += 1
                d = obj.get("data")
                if isinstance(d, bool):
                    out[rid] = "1" if d else "0"
                elif isinstance(d, (int, float)):
                    out[rid] = repr(d)
except OSError:
    pass
print(" ".join(out))
PY
}

# Sends one command (e.g. loadfile, set_property) to a tile's mpv; fire-and-forget.
# Numeric-looking arguments are sent as numbers (set_property speed needs a number).
mpv_cmd() { # mpv_cmd SOCKET CMD ARG...
  python3 - "$@" <<'PY' 2>/dev/null
import json, socket, sys
args = []
for a in sys.argv[2:]:
    try:
        v = json.loads(a)
        args.append(v if isinstance(v, (int, float, bool)) else a)
    except ValueError:
        args.append(a)
try:
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(2)
    s.connect(sys.argv[1])
    s.sendall(json.dumps({"command": args}).encode() + b"\n")
    s.recv(4096)
except OSError:
    pass
PY
}

# mpv flags shared by every tile:
#   discardcorrupt + err_detect: drop damaged packets at the demuxer and flag
#     decode errors, so glitches lean towards a blink instead of a white smear.
#     Deliberately NOT err_detect +explode: that turned decode errors fatal,
#     leaving mpv alive with a black window and no clock - a permanently black
#     tile the first watchdog didn't recognise as sick.
#   keep-open + idle: when the stream dies (network-timeout after ~15s of a
#     dead connection, NVR closing the session, ...), mpv does NOT exit - it
#     holds the LAST FRAME on screen and waits. The supervisor reloads the
#     stream in-place over IPC once the NVR answers again, so an outage shows
#     as a paused picture that resumes, never a black cell + window teardown.
#   force-window=immediate: the cell goes up black right away instead of the
#     root showing through while the RTSP handshake runs.
#   latency: no-audio + video-latency-hacks trim fixed pipeline delay, and
#     cache-secs bounds how much backlog can pile up behind live (~10s worst
#     case instead of the 8M byte cap's 30-60s at substream bitrates). Every
#     stall leaves backlog that 1x playback never burns off - the supervisor's
#     latency governor (see supervise) plays 2x until the tile is back at live.
#   msg-level (not really-quiet): real errors reach the journal so a sick
#     stream is diagnosable.
COMMON_FLAGS=(--no-osc --no-input-default-bindings --no-border --no-keepaspect
              --force-window=immediate
              --keep-open=yes --idle=yes
              --no-audio --video-latency-hacks=yes
              --msg-level=all=error
              --hwdec=auto --rtsp-transport=tcp --network-timeout=15
              --demuxer-lavf-o-add=fflags=+discardcorrupt
              --vd-lavc-o-add=err_detect=+crccheck+bitstream+buffer
              --cache=yes --cache-secs=10 --demuxer-max-bytes=8M --demuxer-max-back-bytes=2M)

# One tile's respawn loop: probe, play, repeat. Runs in the background; the
# supervisor kills the mpv pid (from the pidfile) to force a single-tile
# restart, or kills this loop + the pid to tear the wall down.
tile_loop() { # tile_loop POS URL IP PORT GEOMETRY
  local pos=$1 url=$2 ip=$3 port=$4 geometry=$5
  local sock=$RUN_DIR/kiosk-tile-$pos.sock pidfile=$RUN_DIR/kiosk-tile-$pos.pid
  while true; do
    if ! reachable "$ip" "$port"; then
      say "tile $pos: NVR $ip:$port unreachable - black cell, retrying in 15s"
      sleep 15
      continue
    fi
    mpv "${COMMON_FLAGS[@]}" --geometry="$geometry" --input-ipc-server="$sock" "$url" &
    echo $! > "$pidfile"
    wait $!
    rm -f "$pidfile"    # no pidfile between spawns - the watchdog must never kill a stale pid
    say "tile $pos: player exited - respawning"
    sleep $(( 2 + pos % 3 ))   # stagger so tiles don't all hammer the NVR/WiFi at once
  done
}

# pos-indexed wall state, set by build_wall; kept global so the supervisor can
# respawn a tile loop that has died
TILE_LOOP_PID=()
TILE_URL=()
TILE_IP=()
TILE_PORT=()
TILE_GEOM=()

# Prints the tile's mpv pid only if that pid is alive and really is mpv
# (guards against pid reuse should a pidfile ever go stale).
tile_mpv_pid() { # tile_mpv_pid POS
  local pid
  pid=$(cat "$RUN_DIR/kiosk-tile-$1.pid" 2>/dev/null)
  [[ -n $pid && -r /proc/$pid/comm && $(cat "/proc/$pid/comm" 2>/dev/null) == mpv ]] && echo "$pid"
}

stop_tiles() {
  local pos pid
  for pos in "${!TILE_LOOP_PID[@]}"; do
    kill "${TILE_LOOP_PID[$pos]}" 2>/dev/null
    pid=$(tile_mpv_pid "$pos")
    [[ -n $pid ]] && kill "$pid" 2>/dev/null
    rm -f "$RUN_DIR/kiosk-tile-$pos.pid" "$RUN_DIR/kiosk-tile-$pos.sock"
  done
  # catch any player that was mid-spawn when its loop died (pidfile not yet written)
  pkill -x mpv 2>/dev/null
  TILE_LOOP_PID=(); TILE_URL=(); TILE_IP=(); TILE_PORT=(); TILE_GEOM=()
}

# Parses the config and starts one tile_loop per usable tile.
# Returns 1 if the config is missing/unusable (caller waits and retries).
build_wall() {
  [[ -r $CONFIG ]] || { say "waiting for $CONFIG"; return 1; }
  jq -e . "$CONFIG" >/dev/null 2>&1 || { say "config is not valid JSON"; return 1; }

  local cols rows subtype rotate rout ntiles
  cols=$(jq -r '.gridCols // 0' "$CONFIG")
  rows=$(jq -r '.gridRows // 0' "$CONFIG")
  subtype=$(jq -r '.subtype // 1' "$CONFIG")
  rotate=$(jq -r '.rotate // "none"' "$CONFIG")
  rout=$(jq -r '.rotateOutput // empty' "$CONFIG")
  ntiles=$(jq -r '.tiles | length' "$CONFIG")

  [[ $cols =~ ^[1-6]$ && $rows =~ ^[1-6]$ ]] || { say "gridCols/gridRows must be 1..6"; return 1; }
  [[ $ntiles =~ ^[0-9]+$ ]] && (( ntiles >= 1 )) || { say "no tiles configured"; return 1; }
  local n=$(( cols * rows ))

  # Per-position stream URL + NVR endpoint; tiles outside the grid or with
  # broken fields are skipped (that cell stays black) rather than holding the
  # rest of the wall hostage.
  local url=() tip=() tport=()
  local i pos ip port user pass ch tsub fields
  for (( i=0; i<ntiles; i++ )); do
    # tr strips CRs so CRLF from any jq/file source can't corrupt the fields
    readarray -t fields < <(jq -r ".tiles[$i] | .pos, .ip, .port, .user, .pass, .channel, (.subtype // \"\")" "$CONFIG" | tr -d '\r')
    pos=${fields[0]}; ip=${fields[1]}; port=${fields[2]}
    user=${fields[3]}; pass=${fields[4]}; ch=${fields[5]}; tsub=${fields[6]}
    [[ $tsub =~ ^[01]$ ]] || tsub=$subtype
    [[ $pos =~ ^[0-9]+$ ]] && (( pos < n )) || continue
    if [[ -z $ip || $ip == null || -z $user || $user == null || -z $pass || $pass == null ]]; then
      say "tile $pos is missing ip/user/pass - leaving that cell black"; continue
    fi
    [[ $ch =~ ^[0-9]+$ ]] && (( ch >= 1 )) || { say "tile $pos has an invalid channel - leaving that cell black"; continue; }
    [[ $port =~ ^[0-9]+$ ]] || port=554
    url[$pos]="rtsp://${user}:$(urlencode "$pass")@${ip}:${port}/cam/realmonitor?channel=${ch}&subtype=${tsub}"
    tip[$pos]=$ip; tport[$pos]=$port
  done

  local have=0
  for (( pos=0; pos<n; pos++ )); do [[ -n ${url[$pos]:-} ]] && have=1; done
  (( have )) || { say "no usable tiles inside the ${cols}x${rows} grid"; return 1; }

  apply_rotation "$rotate" "$rout"

  local sw sh
  read -r sw sh < <(screen_size)
  local cell_w=$(( sw / cols )) cell_h=$(( sh / rows ))

  local r c x y w h geometry
  for (( pos=0; pos<n; pos++ )); do
    [[ -n ${url[$pos]:-} ]] || continue
    r=$(( pos / cols )); c=$(( pos % cols ))
    x=$(( c * cell_w )); y=$(( r * cell_h ))
    # last row/column absorbs the integer-division remainder so the wall
    # reaches the screen edges exactly
    w=$cell_w; h=$cell_h
    (( c == cols - 1 )) && w=$(( sw - x ))
    (( r == rows - 1 )) && h=$(( sh - y ))
    geometry="${w}x${h}+${x}+${y}"
    if [[ -n ${KIOSK_DRYRUN:-} ]]; then
      printf 'MPV tile%s' "$pos"
      printf ' %s' "${COMMON_FLAGS[@]}" "--geometry=$geometry" "${url[$pos]}"
      printf '\n'
    else
      TILE_URL[$pos]=${url[$pos]}; TILE_IP[$pos]=${tip[$pos]}
      TILE_PORT[$pos]=${tport[$pos]}; TILE_GEOM[$pos]=$geometry
      tile_loop "$pos" "${url[$pos]}" "${tip[$pos]}" "${tport[$pos]}" "$geometry" &
      TILE_LOOP_PID[$pos]=$!
    fi
  done
  return 0
}

# Watches the running wall. Per tile the goal is "recover with the LEAST
# visible disruption that actually helps", so failures are told apart rather
# than treated with one hammer (v2.0 restarted any 30s stall, which on flaky
# WiFi killed players that were mid-buffer and about to resume by themselves):
#   - stream ended / connection died (mpv at EOF or idle, last frame or black
#     held on screen): reload the stream IN-PLACE over IPC as soon as the NVR
#     answers - the picture resumes without the window ever tearing down.
#     Only if reloads get the player nowhere for STARVE_SECS is it restarted.
#   - clock frozen while data still arrives: wedged decoder - restart that
#     tile after FREEZE_SECS; nothing else can fix it.
#   - clock frozen and NO data arriving: network starvation - mpv is showing
#     the last frame and resumes on its own; leave it alone, restart only
#     after STARVE_SECS as a last resort.
#   - no clock at all for FREEZE_SECS (black window, never started): restart -
#     there is no picture to preserve.
# A tile whose loop died is respawned; no player running is fine (the loop is
# between spawns or probing). Returns when the config file changes.
supervise() {
  local cfg_sig
  cfg_sig=$(md5sum "$CONFIG" 2>/dev/null)
  local -A last_tp last_ct stall_tp stall_ct eof_stall retry nvr_ok
  local have_python=1
  command -v python3 >/dev/null || { have_python=0; say "python3 not found - tile watchdog disabled (config reload still works)"; }

  while true; do
    sleep "$WATCH_INTERVAL"

    if [[ $(md5sum "$CONFIG" 2>/dev/null) != "$cfg_sig" ]]; then
      say "config changed - rebuilding the wall"
      return 0
    fi

    local pos pid sock tp ct eof idle reason key
    nvr_ok=()   # NVR reachability, probed at most once per NVR per sweep
    for pos in "${!TILE_LOOP_PID[@]}"; do
      if ! kill -0 "${TILE_LOOP_PID[$pos]}" 2>/dev/null; then
        say "tile $pos: respawn loop died - restarting it"
        tile_loop "$pos" "${TILE_URL[$pos]}" "${TILE_IP[$pos]}" "${TILE_PORT[$pos]}" "${TILE_GEOM[$pos]}" &
        TILE_LOOP_PID[$pos]=$!
        last_tp[$pos]=""; last_ct[$pos]=""; stall_tp[$pos]=0; stall_ct[$pos]=0; eof_stall[$pos]=0; retry[$pos]=0
        continue
      fi

      (( have_python )) || continue
      pid=$(tile_mpv_pid "$pos")
      if [[ -z $pid ]]; then
        # loop is between spawns / waiting for the NVR - it handles itself
        last_tp[$pos]=""; last_ct[$pos]=""; stall_tp[$pos]=0; stall_ct[$pos]=0; eof_stall[$pos]=0; retry[$pos]=0
        continue
      fi

      sock=$RUN_DIR/kiosk-tile-$pos.sock
      read -r tp ct eof idle lag speed < <(mpv_props "$sock" time-pos demuxer-cache-time eof-reached idle-active demuxer-cache-duration speed)

      if [[ $eof == 1 || $idle == 1 ]]; then
        # stream over (keep-open holds the last frame; idle = load failed, black).
        # Reload in-place once the NVR answers; the window never tears down.
        last_tp[$pos]=""; last_ct[$pos]=""; stall_tp[$pos]=0; stall_ct[$pos]=0
        key="${TILE_IP[$pos]}:${TILE_PORT[$pos]}"
        if [[ -z ${nvr_ok[$key]:-} ]]; then
          if reachable "${TILE_IP[$pos]}" "${TILE_PORT[$pos]}"; then nvr_ok[$key]=1; else nvr_ok[$key]=0; fi
        fi
        if [[ ${nvr_ok[$key]} == 1 ]]; then
          # the give-up clock only ticks while the NVR is answering: after a
          # long outage the FIRST action is a seamless reload, not a restart
          eof_stall[$pos]=$(( ${eof_stall[$pos]:-0} + WATCH_INTERVAL ))
          if (( eof_stall[$pos] >= STARVE_SECS )); then
            say "tile $pos: reloads got nowhere for ${eof_stall[$pos]}s - restarting that camera's player"
            kill "$pid" 2>/dev/null
            eof_stall[$pos]=0; retry[$pos]=0
          else
            retry[$pos]=$(( ${retry[$pos]:-0} - WATCH_INTERVAL ))
            if (( retry[$pos] <= 0 )); then
              say "tile $pos: stream ended - reloading in place (picture holds, no teardown)"
              mpv_cmd "$sock" loadfile "${TILE_URL[$pos]}" replace
              retry[$pos]=15
            fi
          fi
        else
          # NVR unreachable - hold the last frame; nothing we do would help
          eof_stall[$pos]=0; retry[$pos]=0
        fi
        continue
      fi
      eof_stall[$pos]=0; retry[$pos]=0

      if [[ $tp != - && $tp != "${last_tp[$pos]:-}" ]]; then
        last_tp[$pos]=$tp; stall_tp[$pos]=0
      else
        stall_tp[$pos]=$(( ${stall_tp[$pos]:-0} + WATCH_INTERVAL ))
      fi

      # Latency governor: every stall leaves a backlog in the demuxer cache that timed 1x
      # playback carries forever - the wall drifts behind live and stays there. A healthy
      # tile more than 2s behind plays at 2x (a brief fast-forward) until it is within
      # 0.5s of live again.
      if (( stall_tp[$pos] == 0 )) && [[ $lag != - && $speed != - ]]; then
        if awk -v l="$lag" -v s="$speed" 'BEGIN{exit !(s < 1.1 && l > 2)}'; then
          say "tile $pos: ${lag%.*}s behind live - catching up at 2x"
          mpv_cmd "$sock" set_property speed 2
        elif awk -v l="$lag" -v s="$speed" 'BEGIN{exit !(s > 1.1 && l < 0.5)}'; then
          say "tile $pos: caught up to live"
          mpv_cmd "$sock" set_property speed 1
        fi
      fi
      if [[ $ct != - && $ct != "${last_ct[$pos]:-}" ]]; then
        last_ct[$pos]=$ct; stall_ct[$pos]=0
      else
        stall_ct[$pos]=$(( ${stall_ct[$pos]:-0} + WATCH_INTERVAL ))
      fi
      (( stall_tp[$pos] == 0 )) && continue

      reason=""
      if [[ ${last_tp[$pos]:-} == "" ]]; then
        # never produced a clock - black window, nothing on screen to preserve
        (( stall_tp[$pos] >= FREEZE_SECS )) && reason="no playback clock for ${stall_tp[$pos]}s (black window)"
      elif (( stall_ct[$pos] < stall_tp[$pos] )); then
        # data still arriving but the clock is stuck - wedged decoder
        (( stall_tp[$pos] >= FREEZE_SECS )) && reason="clock stuck for ${stall_tp[$pos]}s while data still arrives (wedged player)"
      else
        # no data coming in - network starvation; mpv holds the last frame and
        # resumes by itself, so only step in as a last resort
        (( stall_tp[$pos] >= STARVE_SECS )) && reason="no stream data for ${stall_tp[$pos]}s"
      fi
      if [[ -n $reason ]]; then
        say "tile $pos: $reason - restarting that camera's player"
        kill "$pid" 2>/dev/null
        last_tp[$pos]=""; last_ct[$pos]=""; stall_tp[$pos]=0; stall_ct[$pos]=0
      fi
    done
  done
}

if [[ -n ${KIOSK_DRYRUN:-} ]]; then
  build_wall
  exit $?
fi

trap stop_tiles EXIT

while true; do
  if build_wall; then
    say "wall up (${#TILE_LOOP_PID[@]} tile player(s))"
    supervise
    stop_tiles
  else
    sleep 5    # config missing/invalid - wait for the agent to fix it (reason already logged)
  fi
done
