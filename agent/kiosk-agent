#!/bin/bash
#===============================================================================
# kiosk-agent - keeps this screen in sync with the display manager
#
# Runs as root under systemd (kiosk-agent.service). Every 15 seconds:
#   1. Registers with the manager if we have no API token yet (or ours was
#      rejected) using the enroll token from /etc/kiosk/agent.env.
#   2. Polls the manager with our status; learns desired config/ssh-key
#      versions and any queued commands.
#   3. On config version drift: fetches and validates config, then reloads
#      the stream (kills mpv; cams.sh respawns it with the new config - X is
#      not restarted, so changes appear in a few seconds without a black
#      flash). On key version drift: fetches keys and applies them via
#      kiosk-update-ssh-keys (which refuses empty lists - lockout safety).
#   4. Installs the manager's SSH public key into the kiosk user's
#      authorized_keys behind a forced command (sudo kiosk-trigger, allowed by
#      a one-command sudoers rule), so the manager can wake this agent
#      instantly (SIGUSR1) instead of waiting for the next poll.
#   5. Executes queued commands (restart-display, reboot) and acks them.
#   6. Enforces the power schedule (v2.8): at the scheduled sleep minute it
#      arms the RTC alarm for the next scheduled wake and powers off; boxes
#      whose RTC can't self-wake rely on a WoL relay (the manager queues a
#      "wol:<mac>" command to an awake sibling on the same subnet), and boxes
#      with neither fall back to display-off sleep. A manual power-on during
#      the sleep window stays up until the NEXT scheduled sleep - the trigger
#      only fires in a 2-minute window at the sleep time, and a recently
#      booted box skips it.
#
# The manager being unreachable never affects the running display.
#===============================================================================
set -uo pipefail

AGENT_VERSION="2.9"
ENV_FILE=/etc/kiosk/agent.env
CONF_DIR=/etc/kiosk
POLL_INTERVAL=15

log() { echo "$*"; }

# http METHOD PATH BODYFILE_OUT [DATA] -> echoes HTTP status; body in BODYFILE_OUT
http() {
  local method=$1 path=$2 out=$3 data=${4:-}
  local args=(-sS --connect-timeout 5 --max-time 15 -o "$out" -w '%{http_code}' -X "$method" "$MANAGER_URL$path")
  [[ -n ${API_TOKEN:-} ]] && args+=(-H "Authorization: Bearer $API_TOKEN")
  [[ -n $data ]] && args+=(-H "Content-Type: application/json" -d "$data")
  curl "${args[@]}" 2>/dev/null
}

register() {
  [[ -n ${ENROLL_TOKEN:-} ]] || { log "register: no ENROLL_TOKEN in $ENV_FILE"; return 1; }
  local body out code token id
  body=$(jq -n --arg t "$ENROLL_TOKEN" --arg h "$(hostname)" \
              --arg m "$(cat /etc/machine-id)" --arg v "$AGENT_VERSION" \
              --arg ku "${KIOSK_USER:-}" \
              '{enrollToken:$t, hostname:$h, machineId:$m, agentVersion:$v, kioskUser:$ku}')
  out=$(mktemp)
  code=$(http POST /api/agent/register "$out" "$body") || { rm -f "$out"; log "register: manager unreachable"; return 1; }
  if [[ $code != 200 ]]; then
    log "register: HTTP $code (wrong enroll token?)"
    rm -f "$out"; return 1
  fi
  token=$(jq -r '.apiToken // empty' "$out")
  id=$(jq -r '.screenId // empty' "$out")
  rm -f "$out"
  [[ -n $token && -n $id ]] || { log "register: malformed response"; return 1; }
  sed -i '/^API_TOKEN=/d;/^SCREEN_ID=/d' "$ENV_FILE"
  printf 'API_TOKEN=%s\nSCREEN_ID=%s\n' "$token" "$id" >> "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  log "register: enrolled as $(hostname) (screen $id)"
}

applied_version() { # applied_version FILE -> sanitized integer
  local v
  v=$(cat "$CONF_DIR/$1" 2>/dev/null || echo 0)
  [[ $v =~ ^[0-9]+$ ]] && echo "$v" || echo 0
}

#--- Wake capabilities (v2.8) --------------------------------------------------
# Probed once at startup, reported on every poll so the manager knows how this
# box can be woken. WoL is re-asserted every tick: interface resets restore the
# driver default, the same lesson the WiFi powersave watchdog learned.
RTC_OK=false
WOL_DEV=""
WOL_MAC=""
WOL_OK=false

assert_wol() {
  WOL_OK=false
  [[ -n $WOL_DEV ]] || return 0
  command -v ethtool >/dev/null 2>&1 || return 0
  # WoL needs the cable: magic packets arrive on the wired segment, so a screen running on
  # WiFi (wired NIC without carrier) must not advertise itself as WoL-wakeable - its RTC
  # alarm is its only self-wake. Checked every tick, so plugging in / unplugging is tracked.
  [[ $(cat "/sys/class/net/$WOL_DEV/carrier" 2>/dev/null) == 1 ]] || return 0
  ethtool -s "$WOL_DEV" wol g 2>/dev/null || true
  [[ $(ethtool "$WOL_DEV" 2>/dev/null | sed -n 's/^[[:space:]]*Wake-on: \(.*\)/\1/p') == *g* ]] && WOL_OK=true
  return 0
}

probe_wake_caps() {
  rtcwake --dry-run -m no -s 60 >/dev/null 2>&1 && RTC_OK=true

  # the wired NIC carries WoL: the default-route device if it's ethernet, else the first en*/eth*
  local dev d
  dev=$(ip -o route show default 2>/dev/null | head -1 | sed -n 's/.* dev \([^ ]*\).*/\1/p')
  if [[ -z $dev || $dev == wl* || ! -e /sys/class/net/$dev/device ]]; then
    dev=""
    for d in /sys/class/net/en* /sys/class/net/eth*; do
      [[ -e $d ]] && { dev=$(basename "$d"); break; }
    done
  fi
  [[ -n $dev ]] || { log "wake-caps: rtc=$RTC_OK, no wired interface - WoL unavailable"; return 0; }
  WOL_DEV=$dev
  WOL_MAC=$(cat "/sys/class/net/$dev/address" 2>/dev/null || true)
  assert_wol
  log "wake-caps: rtc=$RTC_OK, wol=$WOL_OK ($WOL_DEV ${WOL_MAC:-no-mac})"
}

send_wol() { # send_wol MAC12HEX - broadcast a magic packet on the local subnet
  python3 - "$1" <<'PY'
import socket, sys
pkt = bytes.fromhex('ff' * 6 + sys.argv[1] * 16)
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
for _ in range(3):
    s.sendto(pkt, ('255.255.255.255', 9))
PY
}

build_status() {
  local active=false ip up
  systemctl is-active --quiet kiosk-display && active=true
  ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  up=$(awk '{print int($1)}' /proc/uptime)
  jq -n --argjson ac "$(applied_version applied-config-version)" \
        --argjson ak "$(applied_version applied-sshkeys-version)" \
        --arg v "$AGENT_VERSION" --argjson da "$active" \
        --arg ip "${ip:-}" --argjson up "${up:-0}" \
        --arg ku "${KIOSK_USER:-}" \
        --argjson rtc "$RTC_OK" --arg wm "${WOL_MAC:-}" --argjson we "$WOL_OK" \
        '{appliedConfigVersion:$ac, appliedSshKeysVersion:$ak, agentVersion:$v,
          displayActive:$da, localIp:$ip, uptimeSeconds:$up, kioskUser:$ku,
          rtcWakeSupported:$rtc, wolMac:(if $wm == "" then null else $wm end), wolEnabled:$we}'
}

apply_config() {
  local want=$1
  [[ $want =~ ^[0-9]+$ ]] && (( want > 0 )) || return 0
  [[ $want -ne $(applied_version applied-config-version) ]] || return 0
  if [[ -z ${KIOSK_USER:-} ]]; then
    log "config: KIOSK_USER not set (missing kiosk.conf?)"
    return 0
  fi

  local out code ver
  out=$(mktemp)
  code=$(http GET /api/agent/config "$out") || { rm -f "$out"; return 0; }
  [[ $code == 200 ]] || { log "config: HTTP $code"; rm -f "$out"; return 0; }
  if ! jq -e '(.gridCols >= 1 and .gridCols <= 6) and (.gridRows >= 1 and .gridRows <= 6)
              and (.tiles | length >= 1)' "$out" >/dev/null 2>&1; then
    log "config: payload failed validation - ignoring"
    rm -f "$out"; return 0
  fi
  ver=$(jq -r '.version' "$out")
  # cams.sh (running as the kiosk user) reads this each mpv respawn
  install -m 640 -o root -g "$KIOSK_USER" "$out" "$CONF_DIR/config.json"
  rm -f "$out"

  # Fleet WiFi (wifiSsid/wifiPassword; nullable, additive - older managers never
  # send them). kiosk-apply-wifi is idempotent (no netplan churn when unchanged)
  # and keeps wired preferred via route metric; blank/absent SSID clears it.
  if command -v kiosk-apply-wifi >/dev/null 2>&1; then
    local wifi_ssid wifi_pass
    wifi_ssid=$(jq -r '.wifiSsid // empty' "$CONF_DIR/config.json")
    wifi_pass=$(jq -r '.wifiPassword // empty' "$CONF_DIR/config.json")
    if [[ -n $wifi_ssid ]]; then
      kiosk-apply-wifi "$wifi_ssid" "$wifi_pass" || log "wifi: apply failed - display continues on current network"
    else
      kiosk-apply-wifi --clear || true
    fi
  fi

  # Reload the stream only: kill mpv and let the cams.sh loop respawn it with
  # the new config. X keeps running - no black flash, ~3-5 s to new video.
  pkill -u "$KIOSK_USER" -x mpv 2>/dev/null || true
  echo "$ver" > "$CONF_DIR/applied-config-version"
  log "config: applied v$ver (stream reloading)"
}

apply_keys() {
  local want=$1
  [[ $want =~ ^[0-9]+$ ]] || return 0
  [[ $want -ne $(applied_version applied-sshkeys-version) ]] || return 0
  # This version was already refused (empty list) - wait for the list to change
  [[ $want -ne $(applied_version refused-sshkeys-version) ]] || return 0

  local out keysfile code ver
  out=$(mktemp); keysfile=$(mktemp)
  code=$(http GET /api/agent/ssh-keys "$out") || { rm -f "$out" "$keysfile"; return 0; }
  if [[ $code != 200 ]]; then log "ssh-keys: HTTP $code"; rm -f "$out" "$keysfile"; return 0; fi
  ver=$(jq -r '.version // empty' "$out")
  jq -r '.keys[]?' "$out" > "$keysfile"
  if kiosk-update-ssh-keys "$keysfile"; then
    echo "$ver" > "$CONF_DIR/applied-sshkeys-version"
    rm -f "$CONF_DIR/refused-sshkeys-version"
    log "ssh-keys: applied v$ver"
  else
    echo "$want" > "$CONF_DIR/refused-sshkeys-version"
    log "ssh-keys: updater refused the list (empty?) - keys unchanged, retrying when the list changes"
  fi
  rm -f "$out" "$keysfile"
}

apply_manager_key() {
  local want=$1
  [[ $want =~ ^[0-9]+$ ]] && (( want > 0 )) || return 0
  [[ $want -ne $(applied_version applied-managerkey-version) ]] || return 0
  if [[ -z ${KIOSK_USER:-} || -z ${KIOSK_HOME:-} ]]; then
    log "manager-key: KIOSK_USER/KIOSK_HOME not set (missing kiosk.conf?)"
    return 0
  fi

  local out code key ver
  out=$(mktemp)
  code=$(http GET /api/agent/manager-key "$out") || { rm -f "$out"; return 0; }
  [[ $code == 200 ]] || { log "manager-key: HTTP $code"; rm -f "$out"; return 0; }
  key=$(jq -r '.publicKey // empty' "$out")
  ver=$(jq -r '.version // 0' "$out")
  rm -f "$out"
  [[ -n $key ]] || { log "manager-key: empty response"; return 0; }

  local ak="$KIOSK_HOME/.ssh/authorized_keys" tmp
  local begin="# >>> kiosk-manager-key (do not edit between markers) >>>"
  local end="# <<< kiosk-manager-key <<<"
  install -d -m 700 -o "$KIOSK_USER" -g "$KIOSK_USER" "$KIOSK_HOME/.ssh"
  touch "$ak"
  tmp=$(mktemp)
  awk -v b="$begin" -v e="$end" '$0==b{skip=1} !skip{print} $0==e{skip=0}' "$ak" > "$tmp"
  {
    echo "$begin"
    # restrict + forced command: this key can only trigger an immediate sync
    # (sudoers rule installed by kiosk-setup.sh allows exactly this command)
    echo "restrict,command=\"sudo /usr/local/sbin/kiosk-trigger\" $key"
    echo "$end"
  } >> "$tmp"
  install -m 600 -o "$KIOSK_USER" -g "$KIOSK_USER" "$tmp" "$ak"
  rm -f "$tmp"
  echo "$ver" > "$CONF_DIR/applied-managerkey-version"
  log "manager-key: installed v$ver for $KIOSK_USER (instant sync enabled)"
}

#--- Power schedule (v2.8, tz-aware since v2.9) --------------------------------
# config.json may carry .power {sleepTime "HH:MM", wakeTime "HH:MM", daysMask,
# timeZone}. daysMask bit N = day-of-week with Sunday=0 and marks the days the
# screen WAKES; sleep fires daily at sleepTime, so a Mon-Fri mask sleeps Friday
# evening through to Monday morning. Absent .power = never sleep.
#
# Schedule times are WALL-CLOCK in .power.timeZone (default Europe/London, the
# fleet's zone) - the boxes' own clocks are UTC, which made v2.8 fire an hour
# late during BST. Every wall-clock date computation goes through pdate.
POWER_TZ="Europe/London"

pdate() { # wall-clock date in the schedule's zone; blank POWER_TZ = the box's own clock
  if [[ -n $POWER_TZ ]]; then TZ=$POWER_TZ date "$@"; else date "$@"; fi
}

hm_to_min() { # "HH:MM" -> minutes since midnight, or -1 when malformed
  [[ $1 =~ ^([0-9]{1,2}):([0-9]{2})$ ]] || { echo -1; return; }
  echo $(( 10#${BASH_REMATCH[1]} * 60 + 10#${BASH_REMATCH[2]} ))
}

next_wake_epoch() { # next_wake_epoch WAKE_HHMM DAYSMASK -> epoch of the next scheduled wake
  local wake=$1 mask=$2 now base d target dow
  now=$(now_epoch)
  base=$(pdate -d "@$now" +%F)
  for d in 0 1 2 3 4 5 6 7; do
    target=$(pdate -d "$base + $d day $wake" +%s 2>/dev/null) || return 1
    (( target > now + 120 )) || continue   # meaningfully in the future (beyond the trigger window)
    dow=$(pdate -d "@$target" +%w)         # 0=Sunday, matching the mask convention
    (( (mask >> dow) & 1 )) && { echo "$target"; return 0; }
  done
  return 1   # empty mask - nothing would ever wake us
}

# seams for the policy test harness - everything time-based derives from now_epoch
now_epoch() { date +%s; }
now_hm() { pdate -d "@$(now_epoch)" +%H:%M; }
today_date() { pdate -d "@$(now_epoch)" +%F; }
uptime_s() { awk '{print int($1)}' /proc/uptime; }
power_off() { systemd-run --on-active=5 systemctl poweroff >/dev/null 2>&1 || systemctl poweroff; }

# arm AND verify: some firmware accepts rtcwake yet never stores the alarm - an empty
# wakealarm means this box would sleep forever, so treat it as an arming failure and
# let the caller fall down the ladder (WoL relay / display-off)
rtc_arm() {
  rtcwake -m no -t "$1" >/dev/null 2>&1 || return 1
  [[ -s /sys/class/rtc/rtc0/wakealarm ]]
}
display_stop() { systemctl stop kiosk-display; }
display_start() { systemctl start kiosk-display; }

check_power_schedule() {
  local cfg="$CONF_DIR/config.json"
  local sleep_t="" wake_t="" mask=0
  local tz=""
  if [[ -r $cfg ]]; then
    sleep_t=$(jq -r '.power.sleepTime // empty' "$cfg" 2>/dev/null)
    wake_t=$(jq -r '.power.wakeTime // empty' "$cfg" 2>/dev/null)
    mask=$(jq -r '.power.daysMask // 0' "$cfg" 2>/dev/null)
    tz=$(jq -r '.power.timeZone // empty' "$cfg" 2>/dev/null)
  fi
  [[ $mask =~ ^[0-9]+$ ]] || mask=0
  [[ -n $tz ]] && POWER_TZ=$tz

  # display-off sleep in progress: resume at the stored wake time, or as soon
  # as the schedule is removed; never evaluate a new sleep while in it
  if [[ -f $CONF_DIR/display-sleep-until ]]; then
    local until
    until=$(cat "$CONF_DIR/display-sleep-until" 2>/dev/null)
    [[ $until =~ ^[0-9]+$ ]] || until=0
    if [[ -z $sleep_t || $mask == 0 ]] || (( $(now_epoch) >= until )); then
      rm -f "$CONF_DIR/display-sleep-until"
      display_start
      log "power: display-off sleep over - display restarted"
    fi
    return 0
  fi

  [[ -n $sleep_t && -n $wake_t && $mask != 0 ]] || return 0

  local sleep_min now_min
  sleep_min=$(hm_to_min "$sleep_t"); now_min=$(hm_to_min "$(now_hm)")
  (( sleep_min >= 0 && now_min >= 0 )) || return 0

  # the trigger is a 2-minute window at the sleep time, once per day - a box
  # powered on manually later in the sleep window therefore stays up
  (( now_min >= sleep_min && now_min < sleep_min + 2 )) || return 0
  [[ $(cat "$CONF_DIR/last-sleep-date" 2>/dev/null) == "$(today_date)" ]] && return 0

  # a recently booted box inside the window was woken on purpose - stay up
  if (( $(uptime_s) < 600 )); then
    log "power: inside the sleep window but only just booted - staying up until the next scheduled sleep"
    return 0
  fi

  local wake_epoch
  wake_epoch=$(next_wake_epoch "$wake_t" "$mask") || { log "power: no wake day in mask $mask - refusing to sleep"; return 0; }

  echo "$(today_date)" > "$CONF_DIR/last-sleep-date"

  if [[ $RTC_OK == true ]] && rtc_arm "$wake_epoch"; then
    log "power: sleeping - RTC alarm armed for $(pdate -d "@$wake_epoch" '+%a %H:%M'), powering off"
    power_off
  elif [[ $WOL_OK == true ]]; then
    log "power: sleeping - no RTC alarm, relying on wake-on-LAN relay at $(pdate -d "@$wake_epoch" '+%a %H:%M'), powering off"
    power_off
  else
    log "power: no RTC alarm and no wake-on-LAN - display-off sleep until $(pdate -d "@$wake_epoch" '+%a %H:%M')"
    echo "$wake_epoch" > "$CONF_DIR/display-sleep-until"
    display_stop
  fi
}

ack() { # ack COMMAND_ID RESULT MESSAGE
  local body out
  body=$(jq -n --arg r "$2" --arg m "$3" '{result:$r, message:$m}')
  out=$(mktemp)
  http POST "/api/agent/commands/$1/ack" "$out" "$body" >/dev/null || true
  rm -f "$out"
}

handle_command() {
  local id type
  id=$(jq -r '.id' <<<"$1")
  type=$(jq -r '.type' <<<"$1")
  log "command: $type ($id)"
  case $type in
    restart-display)
      if systemctl restart kiosk-display; then ack "$id" ok ""
      else ack "$id" error "systemctl restart kiosk-display failed"; fi
      ;;
    reboot)
      # Ack first, then reboot detached so the ack and this loop aren't killed mid-flight
      ack "$id" ok "rebooting"
      systemd-run --on-active=5 systemctl reboot >/dev/null 2>&1 || systemctl reboot
      ;;
    update-agent)
      # Self-update: re-run the installer from the repo. Ack first (the installer restarts this
      # service), and run DETACHED in a transient unit (own cgroup) so 'systemctl restart
      # kiosk-agent' inside the installer doesn't kill the update mid-run. The installer preserves
      # our API token, so no re-registration happens. The new version shows on the next poll.
      ack "$id" ok "updating from v$AGENT_VERSION"
      local update_base=${SCRIPT_BASE_URL:-https://raw.githubusercontent.com/mhenson-ejt/ubuntu-displayscreen/main}
      systemd-run --unit=kiosk-agent-update --collect \
        bash -c "sleep 2; curl -fsSL '$update_base/kiosk-setup.sh' | MANAGER_URL='$MANAGER_URL' ENROLL_TOKEN='${ENROLL_TOKEN:-}' KIOSK_USER='${KIOSK_USER:-viewer}' SCRIPT_BASE_URL='$update_base' bash" \
        >/dev/null 2>&1 \
        || ack "$id" error "failed to launch the updater (see journalctl -u kiosk-agent-update)"
      ;;
    wol:*)
      # Relay a wake-on-LAN magic packet for an asleep sibling on OUR subnet (the manager can't
      # send it itself - magic packets don't cross VLANs). MAC arrives as 12 bare hex digits.
      local mac=${type#wol:}
      if [[ $mac =~ ^[0-9a-fA-F]{12}$ ]] && send_wol "${mac,,}"; then
        ack "$id" ok "magic packet broadcast for $mac"
      else
        ack "$id" error "bad MAC or send failed: $mac"
      fi
      ;;
    *)
      ack "$id" error "unknown command type: $type"
      ;;
  esac
}

# Streams are TCP-bound to the source address of the interface they started on. When the default
# route moves (cable pulled -> WiFi takes over, or cable returns), those connections are dead but
# mpv only notices via its network timeout. Detect the flip each tick and reload the stream
# immediately - cams.sh respawns mpv, which reconnects over the now-active path.
check_route_flip() {
  local dev
  dev=$(ip -o route show default 2>/dev/null | head -1 | sed -n 's/.* dev \([^ ]*\).*/\1/p')
  if [[ -n ${LAST_ROUTE_DEV:-} && -n $dev && $dev != "$LAST_ROUTE_DEV" ]]; then
    log "network: default route moved $LAST_ROUTE_DEV -> $dev - reloading streams"
    [[ -n ${KIOSK_USER:-} ]] && pkill -u "$KIOSK_USER" -x mpv 2>/dev/null
  fi
  [[ -n $dev ]] && LAST_ROUTE_DEV=$dev
  return 0
}

tick() {
  unset API_TOKEN SCREEN_ID
  source "$ENV_FILE" 2>/dev/null || { log "missing $ENV_FILE"; return; }
  source "$CONF_DIR/kiosk.conf" 2>/dev/null || true   # KIOSK_USER, KIOSK_HOME
  check_route_flip
  assert_wol
  check_power_schedule
  [[ -n ${MANAGER_URL:-} ]] || { log "no MANAGER_URL in $ENV_FILE"; return; }
  MANAGER_URL=${MANAGER_URL%/}

  if [[ -z ${API_TOKEN:-} ]]; then
    register || return
    source "$ENV_FILE"
  fi

  local out code resp
  out=$(mktemp)
  code=$(http POST /api/agent/poll "$out" "$(build_status)") || { rm -f "$out"; log "poll: manager unreachable"; return; }
  if [[ $code == 401 ]]; then
    log "poll: token rejected - re-registering next tick"
    sed -i '/^API_TOKEN=/d;/^SCREEN_ID=/d' "$ENV_FILE"
    rm -f "$out"; return
  fi
  [[ $code == 200 ]] || { log "poll: HTTP $code"; rm -f "$out"; return; }
  resp=$(cat "$out"); rm -f "$out"
  jq -e . >/dev/null 2>&1 <<<"$resp" || { log "poll: invalid JSON response"; return; }

  local cfg_ver keys_ver mkey_ver ncmds
  cfg_ver=$(jq -r '.configVersion // 0' <<<"$resp")
  keys_ver=$(jq -r '.sshKeysVersion // 0' <<<"$resp")
  mkey_ver=$(jq -r '.managerKeyVersion // 0' <<<"$resp")
  ncmds=$(jq -r '.commands | length' <<<"$resp")

  apply_config "$cfg_ver"
  apply_keys "$keys_ver"
  apply_manager_key "$mkey_ver"

  while IFS= read -r cmd; do
    [[ -n $cmd ]] && handle_command "$cmd"
  done < <(jq -c '.commands[]?' <<<"$resp")

  log "poll: ok (config v$(applied_version applied-config-version)/$cfg_ver, keys v$(applied_version applied-sshkeys-version)/$keys_ver, commands $ncmds)"
}

# Sourced by the policy test harness, which stubs the seams above and calls the
# functions directly - everything below is the live main loop.
[[ -n ${KIOSK_AGENT_TEST:-} ]] && return 0

# SIGUSR1 (sent by kiosk-trigger when the manager SSHes in) interrupts the
# sleep so changes apply instantly instead of waiting out the poll interval.
# A signal that lands while a tick is still running skips the sleep entirely,
# so back-to-back pushes are never swallowed.
WOKEN=0
trap 'WOKEN=1' USR1

log "kiosk-agent $AGENT_VERSION starting (poll every ${POLL_INTERVAL}s; SIGUSR1 forces an immediate sync)"
probe_wake_caps
while true; do
  WOKEN=0
  TICK_START=$(date +%s)
  tick || true
  if (( WOKEN )); then
    log "sync: woken during tick - polling again"
    continue
  fi
  ELAPSED=$(( $(date +%s) - TICK_START ))
  REMAIN=$(( POLL_INTERVAL - ELAPSED ))
  (( REMAIN < 1 )) && REMAIN=1
  sleep "$REMAIN" &
  SLEEP_PID=$!
  if ! wait "$SLEEP_PID" 2>/dev/null; then
    kill "$SLEEP_PID" 2>/dev/null || true
    (( WOKEN )) && log "sync: woken by manager"
  fi
done
