#!/bin/bash
#===============================================================================
# kiosk-webkiosk - the WEB KIOSK display loop, installed as /etc/kiosk/webkiosk.sh.
#
# Run inside the X session (cams.sh execs this when the screen's type is Web
# kiosk) instead of the camera wall. Shows a configured web page full-screen in
# Falkon (QtWebEngine = Chromium's Blink engine; a plain .deb from the Ubuntu
# archive, no snap). The agent installs the browser when a screen becomes a web
# kiosk. Chromium is still used if someone has installed a real one.
#
# Phase 1: a single URL + an optional periodic refresh. Two placeholder pages:
#   - DEFAULT      : shown when the screen has no kiosk / no URL configured
#   - UNREACHABLE  : shown when the URL can't be reached (checked by curl first,
#                    so we never show Chromium's raw error page); the real URL is
#                    re-checked each cycle and shown again once it comes back.
# Rotation through several pages (per-page dwell) is phase 2.
#
# Mode/URL changes: config.json is polled each cycle. A URL/placeholder change
# relaunches the browser at the new target; a refresh is sent with xdotool (no
# relaunch, no flicker). If the screen is no longer a web kiosk, this exits so
# kiosk-display restarts and cams.sh re-branches to the camera wall.
#===============================================================================
set -uo pipefail

CONFIG=${KIOSK_CONFIG:-/etc/kiosk/config.json}
CHECK_INTERVAL=${KIOSK_WEBKIOSK_INTERVAL:-10}   # reachability + config poll cadence (seconds)

say() { logger -t kiosk-webkiosk -- "$*" 2>/dev/null; echo "kiosk-webkiosk: $*" >&2; }

# The placeholder pages are served over HTTP by the manager (the URL the agent already syncs with) so
# they are edited centrally and match the manager's look. The local file:// copies are the fallback
# (used only if the manager URL is somehow unset); Falkon is a normal .deb and can read them fine.
_resolve_placeholders() {
  local m=${MANAGER_URL%/}
  if [[ -n $m ]]; then
    PLACEHOLDER_DEFAULT_TARGET="$m/kiosk/placeholder/default"
    PLACEHOLDER_UNREACHABLE_TARGET="$m/kiosk/placeholder/unreachable"
  else
    PLACEHOLDER_DEFAULT_TARGET="file://${KIOSK_PLACEHOLDER_DEFAULT:-/etc/kiosk/placeholder-default.html}"
    PLACEHOLDER_UNREACHABLE_TARGET="file://${KIOSK_PLACEHOLDER_UNREACHABLE:-/etc/kiosk/placeholder-unreachable.html}"
  fi
}
MANAGER_URL=""
# kiosk.conf is the viewer-readable base file (agent.env is 600 root - we run as the kiosk user and
# can't read it, which left MANAGER_URL empty and forced the unreadable file:// placeholder fallback).
source /etc/kiosk/kiosk.conf 2>/dev/null || true   # MANAGER_URL (+ KIOSK_USER/HOME)
_resolve_placeholders

# Preferred browser: Falkon (QtWebEngine = Chromium engine, a .deb from the archive). Chromium next,
# only if a real (non-snap) one happens to be installed.
browser_bin() {
  local b
  for b in falkon chromium chromium-browser; do
    command -v "$b" >/dev/null 2>&1 && { echo "$b"; return 0; }
  done
  echo ""
}

# screen_dims -> "W H" from xrandr (same source the camera wall uses), 1920x1080 if it can't be read.
screen_dims() {
  local d
  d=$(xrandr 2>/dev/null | awk '/current/{sub(",", "", $10); print $8, $10; exit}')
  [[ $d =~ ^[0-9]+\ +[0-9]+$ ]] && echo "$d" || echo "1920 1080"
}

# start_wm -> run a tiny window manager so the browser window fills the screen. The boxes run a bare
# X with no WM, so a browser otherwise opens as a small, un-maximised window. matchbox maximises the
# single top-level app window to the whole screen and draws no titlebar/cursor - the standard kiosk
# WM. The camera wall doesn't use it (mpv places its own borderless windows). No-op if absent or
# already running.
start_wm() {
  command -v matchbox-window-manager >/dev/null 2>&1 || { say "matchbox not installed - window may not fill the screen"; return 0; }
  pgrep -x matchbox-window-manager >/dev/null 2>&1 && return 0
  matchbox-window-manager -use_titlebar no -use_cursor no >/dev/null 2>&1 &
  sleep 1
}

# read_cfg -> sets SCREEN_TYPE, URL, REFRESH from config.json
read_cfg() {
  SCREEN_TYPE=$(jq -r '.screenType // 1' "$CONFIG" 2>/dev/null || echo 1)
  URL=$(jq -r '.webKiosk.pages[0].url // empty' "$CONFIG" 2>/dev/null || true)
  REFRESH=$(jq -r '.webKiosk.refreshSeconds // empty' "$CONFIG" 2>/dev/null || true)
  [[ $REFRESH =~ ^[0-9]+$ ]] || REFRESH=""
}

# reachable URL -> 0 if the page responds (HEAD, then GET for servers that refuse HEAD)
reachable() {
  local u=$1
  [[ $u == http://* || $u == https://* ]] || return 1
  curl -ksS -o /dev/null -m 8 --head "$u" 2>/dev/null && return 0
  curl -ksS -o /dev/null -m 8 "$u" 2>/dev/null
}

# choose_target -> the URL (or placeholder) to show, given URL + reachability
choose_target() {
  if [[ -z ${URL:-} ]]; then
    echo "$PLACEHOLDER_DEFAULT_TARGET"
  elif reachable "$URL"; then
    echo "$URL"
  else
    echo "$PLACEHOLDER_UNREACHABLE_TARGET"
  fi
}

launch_browser() {   # launch_browser TARGET -> sets BROWSER_PID (and BROWSER_WID for Falkon)
  local target=$1 bin
  bin=$(browser_bin)
  if [[ -z $bin ]]; then say "no browser installed (falkon/chromium) - cannot show web kiosk"; return 1; fi

  if [[ -n ${KIOSK_DRYRUN:-} ]]; then
    echo "browser: $bin $target"
    BROWSER_PID=0
    BROWSER_WID=""
    return 0
  fi

  case $bin in
    falkon) _launch_falkon "$target" ;;
    *)      _launch_chromium "$bin" "$target" ;;
  esac
}

_launch_falkon() {   # Falkon in a dedicated profile, forced full-screen with xdotool
  local target=$1 dims w h wid
  # Dedicated profile -> no first-run wizard, no session-restore prompt; --no-remote -> this process
  # owns the window (a second falkon can't steal the tab). URL passed positionally (works on every
  # Falkon version).
  falkon --no-remote --profile kiosk "$target" >/dev/null 2>&1 &
  BROWSER_PID=$!
  say "showing $target (falkon pid $BROWSER_PID)"

  # Bare X, no window manager: Falkon won't auto-fill the screen or honour a WM fullscreen request, so
  # drive it directly the way the camera wall drives mpv - size the window to the whole screen, move
  # it to 0,0, focus it, then F11 (Falkon's fullscreen hides its own toolbar + tab bar). windowfocus
  # + an XTEST key (no --window) is used because QtWebEngine ignores synthetic per-window key events.
  dims=$(screen_dims); w=${dims%% *}; h=${dims##* }
  BROWSER_WID=""
  local i
  for i in $(seq 1 30); do
    wid=$(xdotool search --onlyvisible --class '[Ff]alkon' 2>/dev/null | tail -1)
    [[ -n $wid ]] && break
    sleep 0.5
  done
  if [[ -n ${wid:-} ]]; then
    xdotool windowsize "$wid" "$w" "$h" 2>/dev/null || true
    xdotool windowmove "$wid" 0 0 2>/dev/null || true
    xdotool windowfocus "$wid" 2>/dev/null || true
    sleep 0.3
    xdotool key --clearmodifiers F11 2>/dev/null || true
    BROWSER_WID=$wid
  else
    say "falkon window not found via xdotool - page will show but may keep its toolbar"
  fi
}

_launch_chromium() {   # _launch_chromium BIN TARGET
  local bin=$1 target=$2
  # --disable-gpu + friends: these NUCs run a bare X on old Intel graphics, where the GPU process
  # often crashes to a black window; software rendering is plenty for a web page and far more
  # reliable. --disable-dev-shm-usage avoids crashes on the small default /dev/shm.
  "$bin" --kiosk --incognito --noerrdialogs --disable-infobars \
    --disable-session-crashed-bubble --disable-features=TranslateUI --no-first-run \
    --disable-pinch --overscroll-history-navigation=0 --check-for-update-interval=31536000 \
    --password-store=basic --disable-gpu --disable-dev-shm-usage --app="$target" >/dev/null 2>&1 &
  BROWSER_PID=$!
  BROWSER_WID=""   # Chromium --kiosk is already full-screen chromeless; no xdotool needed
  say "showing $target (chromium pid $BROWSER_PID)"
}

refresh_page() {   # send a reload (F5) to the kiosk window
  [[ -n ${KIOSK_DRYRUN:-} ]] && { echo "refresh"; return; }
  command -v xdotool >/dev/null 2>&1 || return 0
  [[ -n ${BROWSER_WID:-} ]] && xdotool windowfocus "$BROWSER_WID" 2>/dev/null || true
  xdotool key --clearmodifiers F5 2>/dev/null || true
}

# Sourced by the test harness, which stubs the helpers and drives them directly.
[[ -n ${KIOSK_WEBKIOSK_TEST:-} ]] && return 0

say "web kiosk display loop starting (config $CONFIG)"
start_wm   # maximise the browser window on the bare, WM-less X

while true; do
  read_cfg
  if [[ $SCREEN_TYPE != 2 ]]; then
    say "screen type is no longer web kiosk - exiting so the display switches"
    exit 0
  fi

  target=$(choose_target)
  cfg_sig=$(md5sum "$CONFIG" 2>/dev/null | awk '{print $1}')

  if ! launch_browser "$target"; then
    sleep "$CHECK_INTERVAL"
    continue
  fi
  shown=$target
  last_refresh=$(date +%s)

  # supervise: keep it up, apply refresh, react to reachability / config / type changes
  while [[ ${KIOSK_DRYRUN:-} ]] || kill -0 "$BROWSER_PID" 2>/dev/null; do
    sleep "$CHECK_INTERVAL"
    [[ -n ${KIOSK_DRYRUN:-} ]] && break

    read_cfg
    if [[ $SCREEN_TYPE != 2 ]]; then
      kill "$BROWSER_PID" 2>/dev/null || true
      say "switched away from web kiosk - exiting"
      exit 0
    fi

    new_sig=$(md5sum "$CONFIG" 2>/dev/null | awk '{print $1}')
    if [[ $new_sig != "$cfg_sig" ]]; then
      say "config changed - reloading"
      break
    fi

    desired=$(choose_target)
    if [[ $desired != "$shown" ]]; then
      say "target changed ($shown -> $desired) - reloading"
      break
    fi

    if [[ -n ${REFRESH:-} && $shown == "$URL" ]]; then
      now=$(date +%s)
      if (( now - last_refresh >= REFRESH )); then
        refresh_page
        last_refresh=$now
      fi
    fi
  done

  kill "$BROWSER_PID" 2>/dev/null || true
  wait "$BROWSER_PID" 2>/dev/null || true
done
