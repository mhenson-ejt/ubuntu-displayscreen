#!/bin/bash
#===============================================================================
# kiosk-maintenance - log into a web-kiosk screen's pages without onlookers
# seeing it, installed as /usr/local/sbin/kiosk-maintenance.
#
#   kiosk-maintenance on [URL]   # start; prints a VNC host:port + one-time password
#   kiosk-maintenance off        # stop and resume the kiosk
#
# While active:
#   - the PHYSICAL screen (:0) shows a placeholder - webkiosk.sh sees the flag
#     file, kills the live kiosk browser (releasing the shared Falkon profile)
#     and shows a placeholder from a THROWAWAY profile, so onlookers see nothing.
#   - the real login runs on a HIDDEN Xvfb display, in Falkon on the SAME
#     'kiosk' profile the live screen uses, RUN AS THE KIOSK USER - so the
#     cookies you create there persist straight back to the live screen.
#   - x11vnc serves that hidden display on the LAN with a one-time password, so
#     an admin can drive the login with a keyboard + mouse remotely.
# On 'off' (or the hard timeout) everything is torn down and webkiosk.sh resumes
# the kiosk, which reloads ALREADY AUTHENTICATED from the shared profile.
#
# Phase 1: LAN-direct VNC (one-time password, auto-timeout). The manager can
# drive it through the agent's maintenance-on/off commands; it can also be run
# by hand on the box for testing.
#===============================================================================
set -uo pipefail

RUN_DIR=/run/kiosk
MAINT_FLAG="$RUN_DIR/maintenance"
MAINT_YIELDED="$RUN_DIR/maintenance-yielded"
STATE_DIR="$RUN_DIR/maint"
CONFIG=${KIOSK_CONFIG:-/etc/kiosk/config.json}
PROFILE=kiosk                                   # the SHARED Falkon profile the live kiosk uses
HIDDEN_DISPLAY=${KIOSK_MAINT_DISPLAY:-:20}      # hidden Xvfb display (far from :0)
VNC_PORT=${KIOSK_MAINT_VNC_PORT:-5900}          # x11vnc, bound to localhost (only the web port is LAN-exposed)
WEB_PORT=${KIOSK_MAINT_WEB_PORT:-6080}          # websockify + noVNC - the admin opens this in a browser
MAX_MINUTES=${KIOSK_MAINT_MAX_MINUTES:-30}      # hard cap - tear down no matter what
SELF=/usr/local/sbin/kiosk-maintenance

KIOSK_USER=viewer
KIOSK_HOME=/home/viewer
source /etc/kiosk/kiosk.conf 2>/dev/null || true   # KIOSK_USER + KIOSK_HOME

# The live kiosk's Chromium profile (webkiosk.sh's KIOSK_CHROMIUM_DIR). The maintenance login runs on
# a SEPARATE profile and the login is copied back here on exit - sharing one profile live was racy:
# any kiosk-display restart relaunched a browser on it and collided (single-instance) with the login.
CHROMIUM_DIR="$KIOSK_HOME/.config/kiosk-chromium"
CHROMIUM_LOGIN_DIR="$KIOSK_HOME/.config/kiosk-chromium-login"

say() { logger -t kiosk-maintenance -- "$*" 2>/dev/null; echo "kiosk-maintenance: $*" >&2; }

browser_bin() {
  local b
  for b in google-chrome-stable google-chrome chromium chromium-browser falkon; do
    command -v "$b" >/dev/null 2>&1 && { echo "$b"; return; }
  done
  echo falkon
}

# seed_profile SRC DST -> DST becomes a clean copy of SRC (kiosk-user-owned, single-instance locks
# dropped); DST is emptied if SRC is absent. Used to seed the login profile from the live one and to
# copy the login back afterwards. Callers must ensure neither profile is in use.
seed_profile() {
  local src=$1 dst=$2
  rm -rf "$dst" 2>/dev/null || true
  if [[ -d $src ]]; then
    cp -a "$src" "$dst" 2>/dev/null || true
    chown -R "$KIOSK_USER":"$KIOSK_USER" "$dst" 2>/dev/null || true
    rm -f "$dst"/Singleton* 2>/dev/null || true
    [[ -f "$dst/Default/Preferences" ]] && sed -i \
      's/"exited_cleanly":false/"exited_cleanly":true/g; s/"exit_type":"[^"]*"/"exit_type":"Normal"/g' \
      "$dst/Default/Preferences" 2>/dev/null || true
  fi
}

# Run an X client as the kiosk user, on a given display, WITH THE KIOSK USER'S HOME - critical, or
# Falkon would use root's profile instead of the shared 'kiosk' one and the login wouldn't carry over.
# (runuser without -l keeps root's env, so HOME and DISPLAY are set explicitly.)
as_user_x() {   # as_user_x DISPLAY cmd...
  local disp=$1; shift
  runuser -u "$KIOSK_USER" -- env HOME="$KIOSK_HOME" DISPLAY="$disp" "$@"
}

ensure_deps() {
  local archive=()
  command -v Xvfb >/dev/null 2>&1 || archive+=(xvfb)
  command -v x11vnc >/dev/null 2>&1 || archive+=(x11vnc)
  command -v matchbox-window-manager >/dev/null 2>&1 || archive+=(matchbox-window-manager)
  command -v websockify >/dev/null 2>&1 || archive+=(websockify)   # web VNC (noVNC in a browser)
  [[ -d /usr/share/novnc ]] || archive+=(novnc)

  local need_chrome=0
  command -v google-chrome-stable >/dev/null 2>&1 || command -v google-chrome >/dev/null 2>&1 || need_chrome=1

  [[ ${#archive[@]} -eq 0 && $need_chrome -eq 0 ]] && return 0

  # A prior install killed mid-configure (e.g. by our own timeout, or a boot-time apt run) leaves dpkg
  # half-done, and then EVERY later apt install aborts in ~1s with "dpkg was interrupted". Heal it first:
  # apt-get install -f runs dpkg --configure -a natively, honours the lock timeout, and is a near no-op
  # when the state is clean.
  DEBIAN_FRONTEND=noninteractive timeout 360 apt-get -o DPkg::Lock::Timeout=300 -y install -f >&2 2>&1 || true

  # Output goes to stderr (visible when run by hand; the agent captures only the WEBVNC line on stdout).
  if (( need_chrome )); then
    say "installing Google Chrome (real .deb, no snap; the snap is confined and ignores --user-data-dir)..."
    snap remove --purge chromium >&2 2>/dev/null || true
    local deb; deb=$(mktemp --suffix=.deb)
    if curl -fsSL -m 180 -o "$deb" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
       && DEBIAN_FRONTEND=noninteractive timeout 360 apt-get -o DPkg::Lock::Timeout=300 -y install "$deb" >&2 \
       && command -v google-chrome-stable >/dev/null 2>&1; then
      rm -f "$deb"
    else
      rm -f "$deb"; say "Chrome install failed (dl.google.com unreachable, or apt lock held)"; return 1
    fi
  fi

  if (( ${#archive[@]} )); then
    say "installing ${archive[*]} (archive .debs)..."
    DEBIAN_FRONTEND=noninteractive timeout 600 sh -c \
      "apt-get -o DPkg::Lock::Timeout=300 -o Acquire::Retries=2 update && apt-get -o DPkg::Lock::Timeout=300 -o Acquire::Retries=2 -y install --no-install-recommends ${archive[*]}" \
      >&2 || { say "dependency install failed/timed out (apt lock held too long, or a slow/unreachable mirror)"; return 1; }
  fi
}

screen_res() {   # WxH of the PHYSICAL display, 1920x1080 fallback
  local d
  d=$(as_user_x :0 xrandr 2>/dev/null | awk '/current/{sub(",", "", $10); printf "%sx%s", $8, $10; exit}')
  [[ $d =~ ^[0-9]+x[0-9]+$ ]] && echo "$d" || echo "1920x1080"
}

lan_ip() { ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}'; }

is_web_kiosk() { [[ "$(jq -r '.screenType // 1' "$CONFIG" 2>/dev/null || echo 1)" == 2 ]]; }

start() {
  # Optional URL. Empty (the usual case) = open a general browser at the new-tab page, so the admin can
  # go to and sign into ANY sites they need; those cookies land in the shared profile the screen uses.
  local url=${1:-}
  if ! is_web_kiosk; then say "not a web-kiosk screen - maintenance login does not apply"; return 2; fi

  ensure_deps || return 1
  mkdir -p "$RUN_DIR" "$STATE_DIR"; chmod 0777 "$RUN_DIR"

  # 1) ask webkiosk.sh to yield :0 (show the placeholder, stop the live browser), and wait for it.
  : > "$MAINT_FLAG"
  say "waiting for the kiosk to yield the display..."
  local i
  for i in $(seq 1 40); do [[ -e $MAINT_YIELDED ]] && break; sleep 0.5; done
  [[ -e $MAINT_YIELDED ]] || say "kiosk did not confirm yield - proceeding"
  sleep 1

  # Seed the SEPARATE login profile from the live one, so the admin sees the sites already signed in
  # and can add/renew more. The live profile is free now (the display is yielded). Using a separate
  # profile means a kiosk-display restart mid-session can never collide with the login.
  seed_profile "$CHROMIUM_DIR" "$CHROMIUM_LOGIN_DIR"

  # 2) hidden display at the physical resolution (-ac: local-only, no xauth needed for the user)
  local res; res=$(screen_res)
  say "starting hidden display $HIDDEN_DISPLAY at $res"
  Xvfb "$HIDDEN_DISPLAY" -screen 0 "${res}x24" -ac -nolisten tcp >/dev/null 2>&1 &
  echo $! > "$STATE_DIR/xvfb.pid"
  sleep 1

  # 3) a WM + a USABLE browser (address bar/tabs kept so the admin can navigate and sign in), on the
  #    SEPARATE login profile, run as the kiosk user. Cookies land in CHROMIUM_LOGIN_DIR and are copied
  #    back to the live profile on exit.
  as_user_x "$HIDDEN_DISPLAY" matchbox-window-manager -use_titlebar no >/dev/null 2>&1 &
  echo $! > "$STATE_DIR/mbox.pid"
  # ${url:+"$url"} passes the URL only if one was given; otherwise the browser opens its new-tab page.
  # dbus-run-session gives Chrome a real session bus, and software WebGL (swiftshader) instead of
  # --disable-gpu, so the browser presents as a normal desktop browser - a stripped kiosk env (no bus,
  # no WebGL) is what trips sites like claude.ai into a CAPTCHA loop. The admin still solves any CAPTCHA.
  local browser; browser=$(browser_bin)
  if [[ $browser == falkon ]]; then
    as_user_x "$HIDDEN_DISPLAY" falkon --profile maintenance-login ${url:+"$url"} >/dev/null 2>&1 &
  else
    # --password-store=basic: a FIXED cookie-encryption key, matching the live display browser - or
    # the cookies saved here (encrypted with the keyring/dbus-session key) can't be decrypted after
    # they're copied to the live profile, and the screen comes back logged OUT.
    as_user_x "$HIDDEN_DISPLAY" dbus-run-session -- "$browser" --user-data-dir="$CHROMIUM_LOGIN_DIR" \
      --password-store=basic --no-first-run --no-default-browser-check --use-gl=angle \
      --use-angle=swiftshader --enable-unsafe-swiftshader --disable-dev-shm-usage --start-maximized \
      ${url:+"$url"} >/dev/null 2>&1 &
  fi
  echo $! > "$STATE_DIR/browser.pid"

  # 4) one-time VNC password; x11vnc on LOCALHOST only (only the web port is LAN-exposed)
  local pw pwfile; pw=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 10)
  pwfile="$STATE_DIR/vnc.pass"
  x11vnc -storepasswd "$pw" "$pwfile" >/dev/null 2>&1
  say "serving hidden display over VNC (localhost:$VNC_PORT)"
  x11vnc -display "$HIDDEN_DISPLAY" -rfbport "$VNC_PORT" -localhost -rfbauth "$pwfile" \
         -forever -shared -noxdamage -timeout "$(( MAX_MINUTES * 60 ))" -bg >/dev/null 2>&1

  # 5) websockify + noVNC: the admin opens this in a browser, no VNC client needed. Serves the noVNC
  #    web app on WEB_PORT and bridges WebSocket <-> x11vnc on localhost.
  say "serving noVNC web client on port $WEB_PORT"
  websockify -D --web=/usr/share/novnc "$WEB_PORT" "localhost:$VNC_PORT" >/dev/null 2>&1 \
    || say "websockify failed to start - web VNC unavailable (raw VNC on localhost still up)"

  # 6) hard cap: auto-exit after MAX_MINUTES regardless
  ( sleep $(( MAX_MINUTES * 60 )); [[ -e $MAINT_FLAG ]] && "$SELF" off ) >/dev/null 2>&1 &
  echo $! > "$STATE_DIR/watchdog.pid"

  local ip weburl; ip=$(lan_ip)
  weburl="http://${ip:-SCREEN-IP}:$WEB_PORT/vnc.html?autoconnect=true&password=$pw"
  say "MAINTENANCE READY  open: $weburl   (expires ${MAX_MINUTES}m, url=$url)"
  # machine-readable last line for the agent to relay to the manager
  echo "WEBVNC $weburl $MAX_MINUTES"
}

stop() {
  say "stopping maintenance"
  [[ -f $STATE_DIR/watchdog.pid ]] && kill "$(cat "$STATE_DIR/watchdog.pid")" 2>/dev/null || true
  pkill -f "websockify.*$WEB_PORT" 2>/dev/null || true
  pkill -f "x11vnc.*-rfbport $VNC_PORT" 2>/dev/null || true
  local p
  for p in browser mbox xvfb; do
    [[ -f $STATE_DIR/$p.pid ]] && kill "$(cat "$STATE_DIR/$p.pid")" 2>/dev/null || true
  done
  sleep 2   # let the login browser exit and flush its cookies to disk before we copy them

  # Copy the login back to the live profile. The display is still yielded (webkiosk is showing the
  # placeholder, waiting for the flag), so the live profile is free to overwrite.
  if [[ -d "$CHROMIUM_LOGIN_DIR" ]]; then
    seed_profile "$CHROMIUM_LOGIN_DIR" "$CHROMIUM_DIR"
    say "login copied to the live profile"
  fi

  rm -f "$MAINT_FLAG"                  # webkiosk.sh drops the placeholder and resumes the kiosk (signed in)
  rm -rf "$STATE_DIR"
  say "maintenance ended - kiosk resuming (signed in)"
}

if [[ $EUID -ne 0 ]]; then
  echo "kiosk-maintenance must run as root (installs packages, manages displays). Try: sudo kiosk-maintenance $*" >&2
  exit 1
fi

case "${1:-}" in
  on)  shift; start "${1:-}";;
  off) stop;;
  *)   echo "usage: kiosk-maintenance on [URL] | off" >&2; exit 2;;
esac
